<div class="mx-auto mt-16 w-full max-w-sm">
  <div class="mb-6 flex flex-col items-center gap-2">
    <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white">BC</span>
    <h1 class="text-lg font-semibold text-slate-900">認証コードの入力</h1>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="mb-4 text-sm text-slate-600">登録済みのメールアドレスに認証コードを送信しました。メールに記載のコードを入力してください。</p>

    <%= form_tag customer_otp_path, method: :post, class: "flex flex-col gap-4" do %>
      <div>
        <%= label_tag :code, "認証コード", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= text_field_tag :code, nil,
              autofocus: true, autocomplete: "one-time-code", inputmode: "numeric",
              maxlength: 6, required: true,
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-center text-lg tracking-[0.5em] focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      </div>

      <%= submit_tag "ログイン", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    <% end %>

    <div class="mt-4 flex flex-col gap-2 border-t border-slate-100 pt-4 text-center text-sm">
      <%= button_to "コードを再送信する", resend_customer_otp_path, method: :post,
            class: "text-indigo-600 hover:underline", form_class: "inline" %>
      <%= link_to "ログイン画面に戻る", new_customer_session_path, class: "text-slate-500 hover:underline" %>
    </div>
  </div>
</div>
