<div class="mx-auto mt-16 w-full max-w-sm">
  <div class="mb-6 flex flex-col items-center gap-2">
    <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white">BC</span>
    <h1 class="text-lg font-semibold text-slate-900">パスワードの再設定</h1>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <% if resource.errors.any? %>
      <div class="mb-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= resource.errors.full_messages.to_sentence %></div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "flex flex-col gap-4" }) do |f| %>
      <%= f.hidden_field :reset_password_token %>

      <div>
        <%= f.label :password, "新しいパスワード", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <% if @minimum_password_length %>
          <p class="mb-1 text-xs text-slate-500">(<%= @minimum_password_length %>文字以上)</p>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      </div>

      <%= f.submit "パスワードを変更", class: "mt-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    <% end %>
  </div>
</div>
