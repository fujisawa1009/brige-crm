<div class="mx-auto mt-16 w-full max-w-sm">
  <div class="mb-6 flex flex-col items-center gap-2">
    <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white">BC</span>
    <h1 class="text-lg font-semibold text-slate-900">パスワードをお忘れの方</h1>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <% if resource.errors.any? %>
      <div class="mb-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= resource.errors.full_messages.to_sentence %></div>
    <% end %>

    <p class="mb-4 text-sm text-slate-600">登録済みのメールアドレスを入力してください。パスワード再設定用のリンクをお送りします。</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "flex flex-col gap-4" }) do |f| %>
      <div>
        <%= f.label :email, "メールアドレス", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      </div>

      <%= f.submit "リセット手順を送信", class: "mt-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    <% end %>

    <div class="mt-4 border-t border-slate-100 pt-4 text-center">
      <%= link_to "ログイン画面に戻る", new_user_session_path, class: "text-sm text-indigo-600 hover:underline" %>
    </div>
  </div>
</div>
