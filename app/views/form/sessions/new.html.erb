<div class="mx-auto mt-16 w-full max-w-sm">
  <div class="mb-6 flex flex-col items-center gap-2">
    <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white">BC</span>
    <h1 class="text-lg font-semibold text-slate-900">受注入力ログイン</h1>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <p class="mb-4 text-sm text-slate-600">代理店CDと営業担当者CDを入力してください。</p>

    <%= form_tag form_sessions_path, method: :post, class: "flex flex-col gap-4" do %>
      <div>
        <%= label_tag :agency_code, "代理店CD", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= text_field_tag :agency_code, nil, autofocus: true, required: true,
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      </div>
      <div>
        <%= label_tag :sales_rep_code, "営業担当者CD", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= text_field_tag :sales_rep_code, nil, required: true,
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      </div>

      <%= submit_tag "次へ", class: "mt-2 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    <% end %>
  </div>
</div>
