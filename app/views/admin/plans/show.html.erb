<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @plan.name %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">商材</dt><dd><%= @plan.product.name %></dd>
    <dt class="font-bold">コード</dt><dd><%= @plan.code %></dd>
    <dt class="font-bold">月額料金</dt><dd><%= @plan.monthly_fee %></dd>
    <dt class="font-bold">有効</dt><dd><%= @plan.is_active %></dd>
  </dl>
  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_plans_path, class: "underline" %>
    <% if policy(@plan).update? %><%= link_to "編集", edit_admin_plan_path(@plan), class: "underline" %><% end %>
    <% if policy(@plan).destroy? %>
      <%= button_to "削除", admin_plan_path(@plan), method: :delete, form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
