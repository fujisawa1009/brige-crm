<% content_for :page_title, "プラン詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900"><%= @plan.name %></h2>
      <p class="text-sm text-slate-500"><%= @plan.product.name %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_plans_path,
            class: "btn-secondary" %>
      <% if policy(@plan).update? %>
        <%= link_to "編集", edit_admin_plan_path(@plan),
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">商材</dt>
        <dd class="mt-1"><%= link_to @plan.product.name, admin_product_path(@plan.product), class: "text-indigo-600 hover:underline" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">コード</dt>
        <dd class="mt-1 font-mono text-slate-800"><%= @plan.code.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">月額料金</dt>
        <dd class="mt-1 text-slate-800"><%= number_to_currency(@plan.monthly_fee, unit: "¥", precision: 0) if @plan.monthly_fee %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">状態</dt>
        <dd class="mt-1"><%= active_badge(@plan.is_active?) %></dd>
      </div>
    </dl>
  </div>

  <% if policy(@plan).destroy? %>
    <div>
      <%= button_to "このプランを削除", admin_plan_path(@plan), method: :delete,
            form: { data: { turbo_confirm: "#{@plan.name} を削除しますか？" } },
            class: "btn-danger" %>
    </div>
  <% end %>
</div>
