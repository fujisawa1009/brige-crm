<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold">プラン</h1>
  <% if policy(Plan).create? %><%= link_to "新規作成", new_admin_plan_path, class: "underline w-fit" %><% end %>
  <table class="border-collapse w-full text-sm">
    <thead><tr><th class="border px-2 py-1 text-left">商材</th><th class="border px-2 py-1 text-left">名称</th><th class="border px-2 py-1 text-left">月額料金</th></tr></thead>
    <tbody>
      <% @plans.each do |plan| %>
        <tr>
          <td class="border px-2 py-1"><%= plan.product.name %></td>
          <td class="border px-2 py-1"><%= link_to plan.name, admin_plan_path(plan) %></td>
          <td class="border px-2 py-1"><%= plan.monthly_fee %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
