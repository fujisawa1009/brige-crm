<% content_for :page_title, "契約条件" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900">契約条件</h2>
      <p class="text-sm text-slate-500">代理店ごとの契約条件バージョンを管理します（適用終了日が未設定＝現行）。</p>
    </div>
    <% if policy(ContractCondition).create? %>
      <%= link_to "新規作成", new_admin_contract_condition_path,
            class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_contract_conditions_path, method: :get, class: "grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4" do %>
      <div>
        <label class="mb-1 block text-xs font-medium text-slate-500">契約条件名</label>
        <%= text_field_tag :q, params[:q], placeholder: "契約条件名で検索",
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-slate-500">代理店</label>
        <%= text_field_tag :agency_q, params[:agency_q], placeholder: "代理店名・CDで検索",
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-slate-500">状態</label>
        <%= select_tag :status,
              options_for_select([ [ "すべて", "" ], [ "現行のみ", "current" ], [ "過去分のみ", "past" ] ], params[:status]),
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div class="col-span-full flex items-center justify-between pt-1">
        <span class="text-sm text-slate-500">全 <%= number_with_delimiter(@pagy.count) %> 件</span>
        <div class="flex gap-2">
          <%= link_to "クリア", admin_contract_conditions_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50" %>
          <%= submit_tag "検索", class: "rounded-md bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <th class="px-4 py-3">代理店</th>
          <th class="px-4 py-3">契約条件名</th>
          <th class="px-4 py-3">適用開始</th>
          <th class="px-4 py-3">適用終了</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @contract_conditions.empty? %>
          <tr>
            <td colspan="5" class="px-4 py-8 text-center text-slate-500">該当する契約条件が見つかりません</td>
          </tr>
        <% end %>
        <% @contract_conditions.each do |contract_condition| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 text-slate-600"><%= link_to contract_condition.agency.name, admin_agency_path(contract_condition.agency), class: "hover:underline" %></td>
            <td class="px-4 py-3 font-medium text-slate-800"><%= link_to contract_condition.name, admin_contract_condition_path(contract_condition), class: "hover:underline" %></td>
            <td class="px-4 py-3 text-slate-600"><%= contract_condition.effective_from %></td>
            <td class="px-4 py-3">
              <% if contract_condition.current? %>
                <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">現行</span>
              <% else %>
                <span class="text-slate-600"><%= contract_condition.effective_until %></span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "詳細", admin_contract_condition_path(contract_condition), class: "text-indigo-600 hover:underline" %>
              <% if policy(contract_condition).update? %>
                <%= link_to "編集", edit_admin_contract_condition_path(contract_condition), class: "ml-3 text-indigo-600 hover:underline" %>
              <% end %>
              <% if policy(contract_condition).destroy? %>
                <%= button_to "削除", admin_contract_condition_path(contract_condition), method: :delete,
                      form: { data: { turbo_confirm: "#{contract_condition.name} を削除しますか？" }, class: "inline ml-3" },
                      class: "text-red-600 hover:underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
