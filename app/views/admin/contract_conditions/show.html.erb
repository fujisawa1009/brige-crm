<% content_for :page_title, "契約条件詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900"><%= @contract_condition.name %></h2>
      <p class="text-sm text-slate-500"><%= @contract_condition.agency.name %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_contract_conditions_path,
            class: "btn-secondary" %>
      <% if policy(@contract_condition).update? %>
        <%= link_to "編集", edit_admin_contract_condition_path(@contract_condition),
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">代理店</dt>
        <dd class="mt-1"><%= link_to @contract_condition.agency.name, admin_agency_path(@contract_condition.agency), class: "text-indigo-600 hover:underline" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">状態</dt>
        <dd class="mt-1">
          <% if @contract_condition.current? %>
            <%= badge_tag "現行", color: "green" %>
          <% else %>
            <%= badge_tag "過去分", color: "slate" %>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">適用開始日</dt>
        <dd class="mt-1 text-slate-800"><%= @contract_condition.effective_from %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">適用終了日</dt>
        <dd class="mt-1 text-slate-800"><%= @contract_condition.effective_until || "—（現行）" %></dd>
      </div>
    </dl>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-1 text-sm font-semibold uppercase tracking-wide text-slate-500">紐づく案件</h3>
    <p class="text-sm text-slate-600">この契約条件を参照している案件は <%= @contract_condition.orders.size %> 件です。</p>
  </div>

  <% if policy(@contract_condition).destroy? %>
    <div>
      <%= button_to "この契約条件を削除", admin_contract_condition_path(@contract_condition), method: :delete,
            form: { data: { turbo_confirm: "#{@contract_condition.name} を削除しますか？" } },
            class: "btn-danger" %>
    </div>
  <% end %>
</div>
