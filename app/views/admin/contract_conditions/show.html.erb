<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @contract_condition.name %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">代理店</dt><dd><%= @contract_condition.agency.name %></dd>
    <dt class="font-bold">適用開始日</dt><dd><%= @contract_condition.effective_from %></dd>
    <dt class="font-bold">適用終了日</dt><dd><%= @contract_condition.effective_until || "現行" %></dd>
  </dl>

  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_contract_conditions_path, class: "underline" %>
    <% if policy(@contract_condition).update? %>
      <%= link_to "編集", edit_admin_contract_condition_path(@contract_condition), class: "underline" %>
    <% end %>
    <% if policy(@contract_condition).destroy? %>
      <%= button_to "削除", admin_contract_condition_path(@contract_condition), method: :delete,
            form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
