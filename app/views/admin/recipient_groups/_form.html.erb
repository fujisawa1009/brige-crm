<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <%= form_with model: recipient_group, url: url, class: "flex flex-col gap-4 max-w-md" do |f| %>
    <% if recipient_group.errors.any? %>
      <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= recipient_group.errors.full_messages.to_sentence %></div>
    <% end %>

    <div>
      <%= f.label :name, "グループ名", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :description, "説明", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_area :description, rows: 3, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="flex items-center gap-2">
      <%= f.check_box :is_active, class: "h-4 w-4 rounded border-slate-300" %>
      <%= f.label :is_active, "有効", class: "text-sm font-medium text-slate-700" %>
    </div>

    <div>
      <p class="mb-1 text-sm font-medium text-slate-700">メンバー（ユーザー）</p>
      <div class="max-h-64 space-y-1 overflow-y-auto rounded-md border border-slate-300 p-3">
        <% User.order(:name).each do |user| %>
          <label class="flex items-center gap-2 py-0.5 text-sm text-slate-700">
            <%= check_box_tag "member_user_ids[]", user.id,
                  recipient_group.recipient_group_members.exists?(recipient_type: "User", recipient_id: user.id),
                  class: "h-4 w-4 rounded border-slate-300" %>
            <%= user.name %>
            <span class="text-xs text-slate-400"><%= user.email %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="flex gap-2 pt-2">
      <%= f.submit "保存", class: "btn-primary" %>
      <%= link_to "キャンセル", admin_recipient_groups_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
