<% content_for :page_title, "宛先グループ詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-bold text-slate-900"><%= @recipient_group.name %></h2>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_recipient_groups_path,
            class: "btn-secondary" %>
      <% if policy(@recipient_group).update? %>
        <%= link_to "編集", edit_admin_recipient_group_path(@recipient_group),
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">状態</dt>
        <dd class="mt-1"><%= active_badge(@recipient_group.is_active?) %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs text-slate-500">説明</dt>
        <dd class="mt-1 text-slate-800"><%= @recipient_group.description.presence || "—" %></dd>
      </div>
    </dl>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">メンバー（<%= @recipient_group.recipient_group_members.size %>人）</h3>
    <% members = @recipient_group.recipient_group_members.includes(:recipient) %>
    <% if members.any? %>
      <ul class="divide-y divide-slate-100">
        <% members.each do |member| %>
          <li class="py-2 text-sm text-slate-800"><%= member.recipient&.name || "（削除済みユーザー）" %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-500">メンバーはまだ登録されていません。</p>
    <% end %>
  </div>

  <% if policy(@recipient_group).destroy? %>
    <div>
      <%= button_to "この宛先グループを削除", admin_recipient_group_path(@recipient_group), method: :delete,
            form: { data: { turbo_confirm: "#{@recipient_group.name} を削除しますか？" } },
            class: "btn-danger" %>
    </div>
  <% end %>
</div>
