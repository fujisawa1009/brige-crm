<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @recipient_group.name %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">説明</dt><dd><%= @recipient_group.description %></dd>
    <dt class="font-bold">有効</dt><dd><%= @recipient_group.is_active %></dd>
    <dt class="font-bold">メンバー数</dt><dd><%= @recipient_group.recipient_group_members.count %></dd>
  </dl>
  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_recipient_groups_path, class: "underline" %>
    <% if policy(@recipient_group).update? %><%= link_to "編集", edit_admin_recipient_group_path(@recipient_group), class: "underline" %><% end %>
    <% if policy(@recipient_group).destroy? %>
      <%= button_to "削除", admin_recipient_group_path(@recipient_group), method: :delete, form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
