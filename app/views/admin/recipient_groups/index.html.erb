<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold">宛先グループ</h1>
  <% if policy(RecipientGroup).create? %><%= link_to "新規作成", new_admin_recipient_group_path, class: "underline w-fit" %><% end %>
  <table class="border-collapse w-full text-sm">
    <thead><tr><th class="border px-2 py-1 text-left">名称</th><th class="border px-2 py-1 text-left">有効</th></tr></thead>
    <tbody>
      <% @recipient_groups.each do |group| %>
        <tr>
          <td class="border px-2 py-1"><%= link_to group.name, admin_recipient_group_path(group) %></td>
          <td class="border px-2 py-1"><%= group.is_active %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
