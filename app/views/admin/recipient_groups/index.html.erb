<% content_for :page_title, "宛先グループ" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900">宛先グループ</h2>
      <p class="text-sm text-slate-500">通知・問い合わせルーティングの宛先となるユーザーグループを管理します。</p>
    </div>
    <% if policy(RecipientGroup).create? %>
      <%= link_to "新規作成", new_admin_recipient_group_path,
            class: "btn-primary" %>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <th class="px-4 py-3">グループ名</th>
          <th class="px-4 py-3">メンバー数</th>
          <th class="px-4 py-3">状態</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @recipient_groups.empty? %>
          <tr>
            <td colspan="4" class="px-4 py-8 text-center text-slate-500">宛先グループが登録されていません</td>
          </tr>
        <% end %>
        <% @recipient_groups.each do |group| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-medium text-slate-800"><%= link_to group.name, admin_recipient_group_path(group), class: "hover:underline" %></td>
            <td class="px-4 py-3 text-slate-600"><%= group.recipient_group_members.size %> 人</td>
            <td class="px-4 py-3"><%= active_badge(group.is_active?) %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "詳細", admin_recipient_group_path(group), class: "text-indigo-600 hover:underline" %>
              <% if policy(group).update? %>
                <%= link_to "編集", edit_admin_recipient_group_path(group), class: "ml-3 text-indigo-600 hover:underline" %>
              <% end %>
              <% if policy(group).destroy? %>
                <%= button_to "削除", admin_recipient_group_path(group), method: :delete,
                      form: { data: { turbo_confirm: "#{group.name} を削除しますか？" }, class: "inline ml-3" },
                      class: "text-red-600 hover:underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
