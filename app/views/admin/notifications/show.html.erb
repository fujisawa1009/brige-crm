<% content_for :page_title, "一斉通知詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900"><%= @notification.title %></h2>
      <p class="text-sm text-slate-500">宛先: <%= notification_target_label(@notification.target_type) %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_notifications_path,
            class: "btn-secondary" %>
      <% if policy(@notification).update? %>
        <%= link_to "編集", edit_admin_notification_path(@notification),
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">状態</p>
      <p class="mt-1"><%= notification_status_badge(@notification.status) %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">合計件数</p>
      <p class="mt-1 text-lg font-bold text-slate-800"><%= @notification.total_count %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">成功</p>
      <p class="mt-1 text-lg font-bold text-green-600"><%= @notification.success_count %></p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">失敗</p>
      <p class="mt-1 text-lg font-bold text-red-600"><%= @notification.failed_count %></p>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">内容</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">予約日時</dt>
        <dd class="mt-1 text-slate-800"><%= @notification.scheduled_at&.strftime("%Y-%m-%d %H:%M") || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">送信日時</dt>
        <dd class="mt-1 text-slate-800"><%= @notification.sent_at&.strftime("%Y-%m-%d %H:%M") || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">件名</dt>
        <dd class="mt-1 text-slate-800"><%= @notification.subject.presence || "—" %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs text-slate-500">本文</dt>
        <dd class="mt-1 text-slate-800"><%= simple_format(@notification.body.presence || "—") %></dd>
      </div>
    </dl>
  </div>

  <% if policy(@notification).update? && @notification.status == Notification::STATUS_DRAFT %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">送信登録</h3>
      <%= form_with url: schedule_admin_notification_path(@notification), method: :post, class: "flex flex-wrap items-end gap-3" do %>
        <div>
          <label class="mb-1 block text-xs font-medium text-slate-500">予約日時（空なら即時送信）</label>
          <input type="datetime-local" name="scheduled_at" class="rounded-md border border-slate-300 px-3 py-2 text-sm">
        </div>
        <button type="submit" class="btn-primary">送信登録</button>
      <% end %>
    </div>
  <% end %>

  <% if policy(@notification).destroy? %>
    <div>
      <%= button_to "この通知を削除", admin_notification_path(@notification), method: :delete,
            form: { data: { turbo_confirm: "#{@notification.title} を削除しますか？" } },
            class: "btn-danger" %>
    </div>
  <% end %>
</div>
