<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @notification.title %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">宛先種別</dt><dd><%= @notification.target_type %></dd>
    <dt class="font-bold">状態</dt><dd><%= @notification.status %></dd>
    <dt class="font-bold">予約日時</dt><dd><%= @notification.scheduled_at %></dd>
    <dt class="font-bold">送信済</dt><dd><%= @notification.sent_at %></dd>
    <dt class="font-bold">件数</dt><dd>合計<%= @notification.total_count %> / 成功<%= @notification.success_count %> / 失敗<%= @notification.failed_count %></dd>
  </dl>
  <% if policy(@notification).update? && @notification.status == Notification::STATUS_DRAFT %>
    <%= form_with url: schedule_admin_notification_path(@notification), method: :post, class: "flex gap-2 items-end" do %>
      <div>
        <label>予約日時（空なら即時送信）</label>
        <input type="datetime-local" name="scheduled_at" class="border rounded px-2 py-1">
      </div>
      <button type="submit" class="bg-blue-600 text-white rounded px-4 py-2">送信登録</button>
    <% end %>
  <% end %>
  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_notifications_path, class: "underline" %>
    <% if policy(@notification).update? %><%= link_to "編集", edit_admin_notification_path(@notification), class: "underline" %><% end %>
    <% if policy(@notification).destroy? %>
      <%= button_to "削除", admin_notification_path(@notification), method: :delete, form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
