<% content_for :page_title, "一斉通知" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900">一斉通知</h2>
      <p class="text-sm text-slate-500">代理店・顧客への一斉通知を作成・送信します。</p>
    </div>
    <% if policy(Notification).create? %>
      <%= link_to "新規作成", new_admin_notification_path,
            class: "btn-primary" %>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <th class="px-4 py-3">タイトル</th>
          <th class="px-4 py-3">宛先</th>
          <th class="px-4 py-3">状態</th>
          <th class="px-4 py-3">件数</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @notifications.empty? %>
          <tr>
            <td colspan="5" class="px-4 py-8 text-center text-slate-500">通知はまだ作成されていません</td>
          </tr>
        <% end %>
        <% @notifications.each do |n| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-medium text-slate-800"><%= link_to n.title, admin_notification_path(n), class: "hover:underline" %></td>
            <td class="px-4 py-3 text-slate-600"><%= notification_target_label(n.target_type) %></td>
            <td class="px-4 py-3">
              <%= notification_status_badge(n.status) %>
            </td>
            <td class="px-4 py-3 text-slate-600">
              <% if n.status == Notification::STATUS_SENT %>
                成功<%= n.success_count %> / 失敗<%= n.failed_count %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "詳細", admin_notification_path(n), class: "text-indigo-600 hover:underline" %>
              <% if policy(n).update? %>
                <%= link_to "編集", edit_admin_notification_path(n), class: "ml-3 text-indigo-600 hover:underline" %>
              <% end %>
              <% if policy(n).destroy? %>
                <%= button_to "削除", admin_notification_path(n), method: :delete,
                      form: { data: { turbo_confirm: "#{n.title} を削除しますか？" }, class: "inline ml-3" },
                      class: "text-red-600 hover:underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
</div>
