<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <%= form_with model: agency, url: url, class: "flex flex-col gap-4 max-w-md" do |f| %>
    <% if agency.errors.any? %>
      <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= agency.errors.full_messages.to_sentence %></div>
    <% end %>

    <% if policy(agency).staff_scope? %>
      <div>
        <%= f.label :agency_group_id, "所属グループ", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :agency_group_id, AgencyGroup.order(:name), :id, :name,
              { include_blank: true }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
    <% end %>
    <div>
      <%= f.label :name, "代理店名", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :agency_code, "代理店CD", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :agency_code, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm font-mono" %>
    </div>
    <div>
      <%= f.label :contact_person, "店所担当者", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :contact_person, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :email_1, "通知先メール1", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :email_1, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="flex items-center gap-2">
      <%= f.check_box :electronic_contract_enabled, class: "h-4 w-4 rounded border-slate-300" %>
      <%= f.label :electronic_contract_enabled, "電子契約フラグ", class: "text-sm font-medium text-slate-700" %>
    </div>

    <div class="flex gap-2 pt-2">
      <%= f.submit "保存", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
      <%= link_to "キャンセル", admin_agencies_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50" %>
    </div>
  <% end %>
</div>
