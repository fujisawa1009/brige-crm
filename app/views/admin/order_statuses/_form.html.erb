<%= form_with model: order_status, url: url, class: "flex flex-col gap-3 max-w-md" do |f| %>
  <% if order_status.errors.any? %><div class="text-red-700"><%= order_status.errors.full_messages.to_sentence %></div><% end %>
  <div>
    <%= f.label :code, "コード" %>
    <%= f.text_field :code, class: "border rounded px-2 py-1 w-full", readonly: order_status.is_system? %>
    <% if order_status.is_system? %><p class="text-xs text-gray-500">システム定義のためコードは変更できません。</p><% end %>
  </div>
  <div><%= f.label :label, "表示名" %><%= f.text_field :label, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :sort_order, "表示順" %><%= f.number_field :sort_order, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :is_active, "有効" %><%= f.check_box :is_active %></div>
  <%= f.submit "保存", class: "bg-blue-600 text-white rounded px-4 py-2 w-fit" %>
<% end %>
