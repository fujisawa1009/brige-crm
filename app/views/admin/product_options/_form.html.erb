<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <%= form_with model: product_option, url: url, class: "flex flex-col gap-4 max-w-md" do |f| %>
    <% if product_option.errors.any? %>
      <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= product_option.errors.full_messages.to_sentence %></div>
    <% end %>

    <div>
      <%= f.label :product_id, "商材", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.collection_select :product_id, Product.order(:name), :id, :name,
            { include_blank: true }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :name, "名称", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :description, "説明", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_area :description, rows: 3, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :monthly_fee, "月額料金", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.number_field :monthly_fee, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :sort_order, "表示順", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.number_field :sort_order, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="flex items-center gap-2">
      <%= f.check_box :is_active, class: "h-4 w-4 rounded border-slate-300" %>
      <%= f.label :is_active, "有効", class: "text-sm font-medium text-slate-700" %>
    </div>

    <div class="flex gap-2 pt-2">
      <%= f.submit "保存", class: "btn-primary" %>
      <%= link_to "キャンセル", admin_product_options_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
