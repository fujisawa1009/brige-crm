<% content_for :page_title, "商材オプション詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900"><%= @product_option.name %></h2>
      <p class="text-sm text-slate-500"><%= @product_option.product.name %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_product_options_path,
            class: "btn-secondary" %>
      <% if policy(@product_option).update? %>
        <%= link_to "編集", edit_admin_product_option_path(@product_option),
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">商材</dt>
        <dd class="mt-1"><%= link_to @product_option.product.name, admin_product_path(@product_option.product), class: "text-indigo-600 hover:underline" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">月額料金</dt>
        <dd class="mt-1 text-slate-800"><%= number_to_currency(@product_option.monthly_fee, unit: "¥", precision: 0) if @product_option.monthly_fee %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">状態</dt>
        <dd class="mt-1"><%= active_badge(@product_option.is_active?) %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs text-slate-500">説明</dt>
        <dd class="mt-1 text-slate-800"><%= @product_option.description.presence || "—" %></dd>
      </div>
    </dl>
  </div>

  <% if policy(@product_option).destroy? %>
    <div>
      <%= button_to "このオプションを削除", admin_product_option_path(@product_option), method: :delete,
            form: { data: { turbo_confirm: "#{@product_option.name} を削除しますか？" } },
            class: "btn-danger" %>
    </div>
  <% end %>
</div>
