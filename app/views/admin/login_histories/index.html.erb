<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold">ログイン履歴</h1>
  <p class="text-sm text-gray-500">専用テーブルではなく監査ログ（AuditLog）を認証系アクションで絞り込んだ画面です。</p>

  <table class="border-collapse w-full text-sm">
    <thead>
      <tr>
        <th class="border px-2 py-1 text-left">日時</th>
        <th class="border px-2 py-1 text-left">ユーザー</th>
        <th class="border px-2 py-1 text-left">イベント</th>
        <th class="border px-2 py-1 text-left">IP</th>
      </tr>
    </thead>
    <tbody>
      <% @audit_logs.each do |log| %>
        <tr>
          <td class="border px-2 py-1"><%= l(log.created_at, format: :long) rescue log.created_at %></td>
          <td class="border px-2 py-1"><%= log.resource_label %></td>
          <td class="border px-2 py-1"><%= log.action %></td>
          <td class="border px-2 py-1"><%= log.ip_address %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
