<% content_for :page_title, "店舗編集" %>

<div class="flex flex-col gap-4">
  <div>
    <h2 class="text-xl font-bold text-slate-900">店舗編集</h2>
    <p class="text-sm text-slate-500">
      <%= link_to @customer.name, admin_customer_path(@customer), class: "text-indigo-600 hover:underline" %>
    </p>
  </div>
  <%= render "form", customer: @customer, store: @store, url: admin_customer_store_path(@customer, @store) %>
</div>
