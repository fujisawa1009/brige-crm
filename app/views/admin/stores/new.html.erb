<% content_for :page_title, "店舗新規作成" %>

<div class="flex flex-col gap-4">
  <div>
    <h2 class="text-xl font-bold text-slate-900">店舗新規作成</h2>
    <p class="text-sm text-slate-500">
      <%= link_to @customer.name, admin_customer_path(@customer), class: "text-indigo-600 hover:underline" %> の店舗を登録します。
    </p>
  </div>
  <%= render "form", customer: @customer, store: @store, url: admin_customer_stores_path(@customer) %>
</div>
