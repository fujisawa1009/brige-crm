<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <%= form_with model: store, url: url, class: "flex flex-col gap-4 max-w-xl" do |f| %>
    <% if store.errors.any? %>
      <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= store.errors.full_messages.to_sentence %></div>
    <% end %>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :store_code, "店舗CD", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.text_field :store_code, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm font-mono" %>
      </div>
      <div>
        <%= f.label :store_name, "ご利用施設名称", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.text_field :store_name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :store_name_kana, "ご利用施設名称（カナ）", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.text_field :store_name_kana, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <% [
           [:postal_code, "郵便番号"], [:prefecture, "都道府県"], [:city, "市区郡"], [:town, "町名"],
           [:address_detail, "番地・ビル・建物名"], [:phone_number, "ご連絡先電話番号"], [:fax_number, "ご連絡先FAX番号"],
           [:business_hours_1, "営業時間1"], [:business_hours_2, "営業時間2"], [:regular_holiday, "定休日"]
         ].each do |field, label| %>
        <div>
          <%= f.label field, label, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.text_field field, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
    </div>
    <div class="flex items-center gap-2">
      <%= f.check_box :is_active, class: "h-4 w-4 rounded border-slate-300" %>
      <%= f.label :is_active, "有効", class: "text-sm font-medium text-slate-700" %>
    </div>

    <div class="flex gap-2 pt-2">
      <%= f.submit "保存", class: "btn-primary" %>
      <%= link_to "キャンセル", admin_customer_stores_path(customer),
            class: "btn-secondary" %>
    </div>
  <% end %>
</div>
