<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @store.store_name %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">店舗CD</dt><dd><%= @store.store_code %></dd>
    <dt class="font-bold">住所</dt>
    <dd><%= [@store.prefecture, @store.city, @store.town, @store.address_detail].join %></dd>
    <dt class="font-bold">電話番号</dt><dd><%= @store.phone_number %></dd>
    <dt class="font-bold">有効</dt><dd><%= @store.is_active %></dd>
  </dl>

  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_customer_stores_path(@customer), class: "underline" %>
    <% if policy(@store).update? %>
      <%= link_to "編集", edit_admin_customer_store_path(@customer, @store), class: "underline" %>
    <% end %>
    <% if policy(@store).destroy? %>
      <%= button_to "削除", admin_customer_store_path(@customer, @store), method: :delete,
            form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
