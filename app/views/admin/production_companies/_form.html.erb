<%= form_with model: production_company, url: url, class: "flex flex-col gap-3 max-w-md" do |f| %>
  <% if production_company.errors.any? %><div class="text-red-700"><%= production_company.errors.full_messages.to_sentence %></div><% end %>
  <div><%= f.label :name, "会社名" %><%= f.text_field :name, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :contact_name, "担当者名" %><%= f.text_field :contact_name, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :email, "メール" %><%= f.text_field :email, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :phone, "電話番号" %><%= f.text_field :phone, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :notes, "備考" %><%= f.text_area :notes, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :is_active, "有効" %><%= f.check_box :is_active %></div>
  <%= f.submit "保存", class: "bg-blue-600 text-white rounded px-4 py-2 w-fit" %>
<% end %>
