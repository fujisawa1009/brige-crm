<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <%= form_with model: production_company, url: url, class: "flex flex-col gap-4 max-w-md" do |f| %>
    <% if production_company.errors.any? %>
      <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= production_company.errors.full_messages.to_sentence %></div>
    <% end %>

    <div>
      <%= f.label :name, "会社名", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :contact_name, "担当者名", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :contact_name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :email, "メール", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :email, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :phone, "電話番号", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :phone, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :notes, "備考", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_area :notes, rows: 3, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="flex items-center gap-2">
      <%= f.check_box :is_active, class: "h-4 w-4 rounded border-slate-300" %>
      <%= f.label :is_active, "有効", class: "text-sm font-medium text-slate-700" %>
    </div>

    <div class="flex gap-2 pt-2">
      <%= f.submit "保存", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
      <%= link_to "キャンセル", admin_production_companies_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50" %>
    </div>
  <% end %>
</div>
