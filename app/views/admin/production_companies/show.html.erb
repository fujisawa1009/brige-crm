<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @production_company.name %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">担当者名</dt><dd><%= @production_company.contact_name %></dd>
    <dt class="font-bold">メール</dt><dd><%= @production_company.email %></dd>
    <dt class="font-bold">電話番号</dt><dd><%= @production_company.phone %></dd>
    <dt class="font-bold">有効</dt><dd><%= @production_company.is_active %></dd>
  </dl>
  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_production_companies_path, class: "underline" %>
    <% if policy(@production_company).update? %><%= link_to "編集", edit_admin_production_company_path(@production_company), class: "underline" %><% end %>
    <% if policy(@production_company).destroy? %>
      <%= button_to "削除", admin_production_company_path(@production_company), method: :delete, form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
