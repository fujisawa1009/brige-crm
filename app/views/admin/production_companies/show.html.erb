<% content_for :page_title, "制作会社詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-bold text-slate-900"><%= @production_company.name %></h2>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_production_companies_path,
            class: "btn-secondary" %>
      <% if policy(@production_company).update? %>
        <%= link_to "編集", edit_admin_production_company_path(@production_company),
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">担当者名</dt>
        <dd class="mt-1 text-slate-800"><%= @production_company.contact_name.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">状態</dt>
        <dd class="mt-1"><%= active_badge(@production_company.is_active?) %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">メール</dt>
        <dd class="mt-1 text-slate-800"><%= @production_company.email.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">電話番号</dt>
        <dd class="mt-1 text-slate-800"><%= @production_company.phone.presence || "—" %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs text-slate-500">備考</dt>
        <dd class="mt-1 text-slate-800"><%= @production_company.notes.presence || "—" %></dd>
      </div>
    </dl>
  </div>

  <% if policy(@production_company).destroy? %>
    <div>
      <%= button_to "この制作会社を削除", admin_production_company_path(@production_company), method: :delete,
            form: { data: { turbo_confirm: "#{@production_company.name} を削除しますか？" } },
            class: "btn-danger" %>
    </div>
  <% end %>
</div>
