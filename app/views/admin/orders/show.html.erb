<% content_for :page_title, "案件詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900 font-mono"><%= @order.order_number %></h2>
      <p class="text-sm text-slate-500"><%= @order.customer.name %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_orders_path,
            class: "btn-secondary" %>
      <% if policy(@order).update? %>
        <%= link_to "編集", edit_admin_order_path(@order),
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">案件ステータス</dt>
        <dd class="mt-1"><%= order_status_badge(@order.status) %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">契約ステータス</dt>
        <dd class="mt-1"><%= contract_status_badge(@order.contract_status) %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">契約顧客</dt>
        <dd class="mt-1"><%= link_to @order.customer.name, admin_customer_path(@order.customer), class: "text-indigo-600 hover:underline" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">設置先店舗</dt>
        <dd class="mt-1 text-slate-800"><%= @order.store&.store_name || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">販売代理店</dt>
        <dd class="mt-1"><%= link_to @order.agency.name, admin_agency_path(@order.agency), class: "text-indigo-600 hover:underline" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">契約条件</dt>
        <dd class="mt-1"><%= link_to @order.contract_condition.name, admin_contract_condition_path(@order.contract_condition), class: "text-indigo-600 hover:underline" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">プラン</dt>
        <dd class="mt-1 text-slate-800"><%= @order.plan&.name || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">支払方法</dt>
        <dd class="mt-1 text-slate-800"><%= PaymentMethod.find_by(code: @order.payment_method)&.label || @order.payment_method.presence || "—" %></dd>
      </div>
    </dl>
  </div>

  <% if policy(@order).transition_contract? %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">契約ワークフロー</h3>

      <% available_events = contract_status_available_events(@order) %>
      <% if available_events.any? %>
        <%= form_with model: ContractReview.new, url: admin_order_contract_reviews_path(@order),
              class: "flex flex-col gap-3 max-w-md" do |f| %>
          <div>
            <%= f.label :event, "遷移イベント", class: "mb-1 block text-sm font-medium text-slate-700" %>
            <%= f.select :event, available_events,
                  {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          </div>
          <div>
            <%= f.label :reason, "理由（差戻し時など）", class: "mb-1 block text-sm font-medium text-slate-700" %>
            <%= f.text_area :reason, rows: 2, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          </div>
          <div>
            <%= f.label :returned_to, "差戻し先", class: "mb-1 block text-sm font-medium text-slate-700" %>
            <%= f.select :returned_to, [ %w[営業担当者 sales_representative], %w[顧客 customer] ],
                  { include_blank: "（差戻し以外は空欄）" }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          </div>
          <div>
            <%= f.label :comment, "コメント", class: "mb-1 block text-sm font-medium text-slate-700" %>
            <%= f.text_area :comment, rows: 2, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          </div>
          <%= f.submit "イベントを投入", class: "self-start btn-primary" %>
        <% end %>
      <% else %>
        <p class="text-sm text-slate-500">現在のステータス（<%= contract_status_label(@order.contract_status) %>）から遷移可能なイベントはありません。</p>
      <% end %>

      <% if @order.contract_reviews.any? %>
        <h4 class="mt-6 mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">遷移履歴</h4>
        <div class="overflow-x-auto rounded-md border border-slate-200">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                <th class="px-3 py-2">日時</th>
                <th class="px-3 py-2">イベント</th>
                <th class="px-3 py-2">遷移</th>
                <th class="px-3 py-2">実施者</th>
                <th class="px-3 py-2">理由・コメント</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @order.contract_reviews.order(performed_at: :desc).each do |review| %>
                <tr>
                  <td class="px-3 py-2 whitespace-nowrap text-slate-600"><%= review.performed_at.strftime("%Y-%m-%d %H:%M") %></td>
                  <td class="px-3 py-2 font-mono text-slate-600"><%= review.event %></td>
                  <td class="px-3 py-2 text-slate-800"><%= contract_status_label(review.from_status) %> → <%= contract_status_label(review.to_status) %></td>
                  <td class="px-3 py-2 text-slate-600"><%= review.performed_by&.name || "—" %></td>
                  <td class="px-3 py-2 text-slate-600"><%= [ review.reason, review.comment ].compact_blank.join(" / ").presence || "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">日程</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div>
        <dt class="text-xs text-slate-500">受注日</dt>
        <dd class="mt-1 text-slate-800"><%= @order.ordered_at&.to_date || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">契約開始日</dt>
        <dd class="mt-1 text-slate-800"><%= @order.contract_start_date || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">作業完了日</dt>
        <dd class="mt-1 text-slate-800"><%= @order.work_completed_at || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">解約日</dt>
        <dd class="mt-1 text-slate-800"><%= @order.cancelled_at || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">終了日</dt>
        <dd class="mt-1 text-slate-800"><%= @order.terminated_at || "—" %></dd>
      </div>
    </dl>
  </div>

  <% if @order.remarks.present? || @order.shared_notes.present? %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">備考</h3>
      <% if @order.remarks.present? %>
        <p class="text-sm text-slate-800"><span class="text-xs text-slate-500">備考:</span> <%= @order.remarks %></p>
      <% end %>
      <% if @order.shared_notes.present? %>
        <p class="mt-2 text-sm text-slate-800"><span class="text-xs text-slate-500">共有事項:</span> <%= @order.shared_notes %></p>
      <% end %>
    </div>
  <% end %>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">GBP/SNS作業詳細</h3>
    <% if @order.order_work_detail %>
      <%= link_to "作業詳細を見る", "#", class: "text-sm text-indigo-600 hover:underline" %>
      <p class="mt-2 text-xs text-slate-500">
        システムアカウント/SNSアカウントのID・PASSはPII暗号化済みのためこの一覧・詳細画面には表示しません
        （pii-handling-rules.md §1 分類B。参照が必要な運用フローはR3以降で個別に設計する）。
      </p>
    <% else %>
      <p class="text-sm text-slate-500">作業詳細は未登録です。</p>
    <% end %>
  </div>

  <% if policy(@order).destroy? %>
    <div>
      <%= button_to "この案件を削除", admin_order_path(@order), method: :delete,
            form: { data: { turbo_confirm: "#{@order.order_number} を削除しますか？" } },
            class: "btn-danger" %>
    </div>
  <% end %>
</div>
