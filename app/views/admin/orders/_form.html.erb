<%= form_with model: order, url: url, class: "flex flex-col gap-6 max-w-4xl" do |f| %>
  <% if order.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= order.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">契約基本</h3>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :customer_id, "契約顧客", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :customer_id, @customers, :id, :name,
              { include_blank: true }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :store_id, "設置先店舗", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :store_id, @stores, :id, :store_name,
              { include_blank: true }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <% if policy(order).staff_scope? %>
        <div>
          <%= f.label :agency_id, "販売代理店", class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.collection_select :agency_id, Agency.order(:name), :id, :name,
                { include_blank: true }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
      <div>
        <%= f.label :contract_condition_id, "契約条件", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :contract_condition_id, @contract_conditions, :id, :name,
              { include_blank: true }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :sales_representative_id, "担当営業担当者", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :sales_representative_id, @sales_representatives, :id, :name,
              { include_blank: true }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :plan_id, "プラン", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :plan_id, Plan.order(:name), :id, :name,
              { include_blank: true }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :product_initial_fee_id, "初期費用", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :product_initial_fee_id, ProductInitialFee.order(:name), :id, :name,
              { include_blank: true }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :status, "案件ステータス", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :status, OrderStatus.ordered, :code, :label,
              {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :payment_method, "支払方法", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :payment_method, PaymentMethod.ordered.active, :code, :label,
              { include_blank: true }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <% [ [:serial_id, "シリアルID"], [:plus_applied, "Plus申込有無"] ].each do |field, label| %>
        <div>
          <%= f.label field, label, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.text_field field, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
    </div>
    <p class="mt-3 text-xs text-slate-500">
      契約ステータスはこの編集画面では変更できません。案件詳細の「契約ワークフロー」から遷移イベントを投入してください。
    </p>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">日程</h3>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% [
           [:ordered_at, "受注日"], [:contract_start_date, "契約開始日"], [:contract_sent_at, "契約書送付日"],
           [:issued_at, "発注日"], [:account_issued_at, "アカウント発行日"], [:work_completed_at, "作業完了日"],
           [:payment_collected_at, "決済回収日"], [:payment_doc_confirmed_at, "決済書類確認日"],
           [:cancelled_at, "キャンセル日"], [:terminated_at, "解約日"],
           [:elderly_consent_collected_at, "高齢者同意書回収日"], [:business_auth_doc_collected_at, "業務権限証明書回収日"],
           [:inspection_call_completed_at, "検収確認コール完了日"]
         ].each do |field, label| %>
        <div>
          <%= f.label field, label, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.date_field field, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
    </div>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <% [
           [:accounting_month, "計上月"], [:bridge_accounting_month, "Bridge計上月"], [:termination_reason, "解約理由"]
         ].each do |field, label| %>
        <div>
          <%= f.label field, label, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.text_field field, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">確認コール・検収コール</h3>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <% [
           [:confirm_call_staff_name, "確認コール架電担当名"], [:confirm_call_preferred_date, "確認コール連絡希望日"],
           [:confirm_call_time, "確認コール架電時間"], [:confirm_call_contact_name, "確認コール担当者名"],
           [:inspection_call_ng_time, "検収コールNG時間帯"]
         ].each do |field, label| %>
        <div>
          <%= f.label field, label, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.text_field field, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
    </div>
    <div class="mt-4 grid grid-cols-1 gap-4">
      <% [
           [:confirm_call_notes, "確認コール詳細"], [:confirm_call_remarks, "確認コール備考"],
           [:inspection_call_history, "検収コール履歴"]
         ].each do |field, label| %>
        <div>
          <%= f.label field, label, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.text_area field, rows: 3, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">同意・証明書類</h3>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <% [
           [:elderly_consent, "高齢者同意書"], [:business_auth_doc, "業務権限証明書"], [:business_proof, "個人事業主事業証明"],
           [:consent_status, "同意状況"], [:consent_rep_age, "同意時代表者年齢"], [:consent_contact_age, "同意時担当者年齢"],
           [:paper_address_note, "用紙の送付先住所記載"]
         ].each do |field, label| %>
        <div>
          <%= f.label field, label, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.text_field field, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">経理・請求</h3>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <% [
           [:sales_mgmt_slip_number, "販管売上伝票番号"], [:factor_notes, "ファクター回収備考"],
           [:bundled_billing, "おまとめ請求"], [:bundle_target_order_number, "おまとめ先案件番号"]
         ].each do |field, label| %>
        <div>
          <%= f.label field, label, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.text_field field, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">信販・設置先情報</h3>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <% [
           [:finance_division, "信販区分"], [:finance_installer, "設置先（信販）"],
           [:finance_postal_code, "設置先郵便番号"], [:finance_prefecture, "設置先_都道府県"],
           [:finance_city, "設置先_市区町村"], [:finance_town, "設置先_町名"],
           [:finance_address_detail, "設置先_番地"], [:finance_building, "設置先_ビル名"], [:finance_phone, "設置先電話番号"]
         ].each do |field, label| %>
        <div>
          <%= f.label field, label, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.text_field field, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">会員・管理コード</h3>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <% [
           [:member_id, "会員管理ID"], [:meo_mgmt_number, "MEO施策管理番号"], [:toss_up_code, "トスアップCD"]
         ].each do |field, label| %>
        <div>
          <%= f.label field, label, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.text_field field, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
      <div>
        <%= f.label :billing_password, "請求パスワード（PII暗号化対象）", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.password_field :billing_password, value: nil, autocomplete: "new-password",
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">Bridge移行</h3>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <% [
           [:bridge_migration, "Bridge移行フラグ"], [:bridge_migration_order_number, "Bridge移行案件番号"],
           [:bridge_agency_name, "Bridge販売店名"], [:bridge_sales_rep_name, "Bridge営業担当者名"]
         ].each do |field, label| %>
        <div>
          <%= f.label field, label, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.text_field field, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">オプション申込（サイテーション・広告等）</h3>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <% [
           [:citation_applied, "サイテーション申し込み"], [:citation_count, "サイテーション申し込み数"],
           [:citation_existing_serial, "サイテーション既存シリアル"], [:domestic_citation_plan, "国内サイテーションプラン"],
           [:citation_plan, "サイテーションプラン"], [:s_plan_cms, "SプランCMS申込"],
           [:owlet_cms, "OwletCMS申込"], [:onerank_cms, "OnerankCMS申込"],
           [:external_link_applied, "外部リンク申し込み"], [:external_link_count, "外部リンク申し込み数"],
           [:external_link_type, "外部リンクの型"], [:gbp_multilingual, "GBPインバウンド多言語対策"],
           [:language_selection, "言語選択"], [:meo_existing_serial, "MEO既存シリアル"],
           [:infobiz_applied, "infoBiz申し込み"], [:meo_premium_applied, "MEOプレミアム申し込み"],
           [:google_ads_applied, "Google広告申し込み"], [:google_ads_count, "Google広告申し込み数"],
           [:google_review_display, "Google口コミ表示"], [:review_heading, "口コミ表示の見出し名"],
           [:reservation_system, "予約システム"], [:portal_site_applied, "ポータルサイト掲載の申し込み"]
         ].each do |field, label| %>
        <div>
          <%= f.label field, label, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.text_field field, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">備考</h3>
    <div class="grid grid-cols-1 gap-4">
      <% [ [:remarks, "備考"], [:shared_notes, "共有事項"] ].each do |field, label| %>
        <div>
          <%= f.label field, label, class: "mb-1 block text-sm font-medium text-slate-700" %>
          <%= f.text_area field, rows: 3, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex gap-2">
    <%= f.submit "保存", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    <%= link_to "キャンセル", admin_orders_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50" %>
  </div>
<% end %>
