<% content_for :page_title, "案件" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900">案件</h2>
      <p class="text-sm text-slate-500">受注済みの案件を管理します。</p>
    </div>
    <div class="flex gap-2">
      <% if policy(Order).index? %>
        <%# R6-7: 受注日→契約開始日→納品日等の経過管理をガントチャートで表示する画面への導線。 %>
        <%= link_to "ガント表示", gantt_admin_orders_path, class: "btn-secondary" %>
        <%= button_to "CSVエクスポート", export_admin_orders_path, method: :post,
              class: "btn-secondary" %>
      <% end %>
      <% if policy(Order).create? %>
        <%= link_to "新規作成", new_admin_order_path,
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <%#
    案件検索（CEO指示 2026-08-20 タスク7 の12条件）。条件の実体は app/services/order_search.rb。
    顧客一覧（タスク2）と同じくCEO指示により折りたたみは使わず全条件を常時表示する。
    テキスト・選択系と日付レンジ（6種）でグリッドを分け、日付は1セルに入力欄が2つ入るぶん広く取る。

    ラベル「顧客ステータス」は CEO決定 2026-08-20（status-naming-analysis.md §0-0）。
    この画面は案件自身のステータスと顧客のステータスが並ぶため区別が要る。案件自身は「ステータス」のまま。
  %>
  <% input_class = "w-full min-w-0 rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  <% label_class = "mb-1 block text-xs font-medium text-slate-500" %>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_orders_path, method: :get, class: "flex flex-col gap-3" do %>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <div class="sm:col-span-2">
          <label class="<%= label_class %>">フリーワード</label>
          <%= text_field_tag :q, order_search_params[:q], placeholder: "案件番号・会員管理ID・顧客番号・顧客名・カナ・代表者名・メール・電話",
                class: input_class %>
        </div>
        <div>
          <label class="<%= label_class %>">案件番号</label>
          <%= text_field_tag :order_number, order_search_params[:order_number], placeholder: "部分一致",
                class: input_class %>
        </div>
        <div>
          <label class="<%= label_class %>">顧客番号</label>
          <%= text_field_tag :customer_number, order_search_params[:customer_number], placeholder: "部分一致",
                class: input_class %>
        </div>
        <div>
          <label class="<%= label_class %>">会員管理ID</label>
          <%= text_field_tag :member_id, order_search_params[:member_id], placeholder: "部分一致",
                class: input_class %>
        </div>
        <div>
          <label class="<%= label_class %>">ステータス</label>
          <%= select_tag :status, options_from_collection_for_select(OrderStatus.ordered, :code, :label, order_search_params[:status]),
                include_blank: "すべて", class: input_class %>
        </div>
        <div>
          <label class="<%= label_class %>">顧客ステータス</label>
          <%= select_tag :customer_status, options_from_collection_for_select(CustomerStatus.ordered, :code, :label, order_search_params[:customer_status]),
                include_blank: "すべて", class: input_class %>
        </div>
        <%#
          R6-6: 既定は完了/終了系ステータス（OrderStatus#is_completed）を除外して表示する。
          チェックを入れると include_completed=1 が送信され、CompletionStatusFilterが絞り込みを外す。
        %>
        <div class="flex items-end">
          <label class="flex w-full cursor-pointer items-center gap-2 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700">
            <%= check_box_tag :include_completed, "1", order_search_params[:include_completed].present?,
                  class: "h-4 w-4 rounded border-slate-300" %>
            完了済みを含む
          </label>
        </div>
        <%# 項目12: 検収確認コール完了日が入っている案件だけを抜く（NOT NULL）。 %>
        <div class="flex items-end sm:col-span-2">
          <label class="flex w-full cursor-pointer items-center gap-2 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700">
            <%= check_box_tag :inspection_call_present, "1", OrderSearch.inspection_call_present?(order_search_params),
                  class: "h-4 w-4 rounded border-slate-300" %>
            検収確認コール完了日の入力があるものすべて
          </label>
        </div>
      </div>

      <%# 期間指定6種。1セルに入力欄が2つ入るため、3列になるのは xl 以上に絞って狭さを避ける。 %>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
        <% {
             "受注日" => %i[ordered_from ordered_to],
             "契約開始日" => %i[contract_start_from contract_start_to],
             "キャンセル日" => %i[cancelled_from cancelled_to],
             "解約日" => %i[terminated_from terminated_to],
             "決済回収日" => %i[payment_collected_from payment_collected_to],
             "検収確認コール完了日" => %i[inspection_call_from inspection_call_to]
           }.each do |label, (from_key, to_key)| %>
          <div>
            <label class="<%= label_class %>"><%= label %></label>
            <div class="flex items-center gap-2">
              <%= date_field_tag from_key, order_search_params[from_key], class: input_class %>
              <span class="text-sm text-slate-400">〜</span>
              <%= date_field_tag to_key, order_search_params[to_key], class: input_class %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
        <span class="text-sm text-slate-500">全 <%= number_with_delimiter(@pagy.count) %> 件</span>
        <div class="flex gap-2">
          <%= link_to "クリア", admin_orders_path, class: "btn-secondary" %>
          <%= submit_tag "検索", class: "rounded-md bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <th class="px-4 py-3">案件番号</th>
          <th class="px-4 py-3">契約顧客</th>
          <th class="px-4 py-3">販売代理店</th>
          <th class="px-4 py-3">受注日</th>
          <th class="px-4 py-3">ステータス</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @orders.empty? %>
          <tr>
            <td colspan="6" class="px-4 py-8 text-center text-slate-500">該当する案件が見つかりません</td>
          </tr>
        <% end %>
        <% @orders.each do |order| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-mono text-slate-600"><%= link_to order.order_number, admin_order_path(order), class: "hover:underline" %></td>
            <td class="px-4 py-3 font-medium text-slate-800"><%= link_to order.customer.name, admin_customer_path(order.customer), class: "hover:underline" %></td>
            <td class="px-4 py-3 text-slate-600"><%= order.agency.name %></td>
            <td class="px-4 py-3 text-slate-600"><%= order.ordered_at&.to_date || "—" %></td>
            <td class="px-4 py-3">
              <%= order_status_badge(order.status) %>
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "詳細", admin_order_path(order), class: "text-indigo-600 hover:underline" %>
              <% if policy(order).update? %>
                <%= link_to "編集", edit_admin_order_path(order), class: "ml-3 text-indigo-600 hover:underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
</div>
