<% content_for :page_title, "案件" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900">案件</h2>
      <p class="text-sm text-slate-500">受注済みの案件を管理します。</p>
    </div>
    <div class="flex gap-2">
      <% if policy(Order).index? %>
        <%= button_to "CSVエクスポート", export_admin_orders_path, method: :post,
              class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% end %>
      <% if policy(Order).create? %>
        <%= link_to "新規作成", new_admin_order_path,
              class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_orders_path, method: :get, class: "grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3" do %>
      <div>
        <label class="mb-1 block text-xs font-medium text-slate-500">案件番号</label>
        <%= text_field_tag :q, params[:q], placeholder: "案件番号で検索",
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-slate-500">案件ステータス</label>
        <%= select_tag :status, options_from_collection_for_select(OrderStatus.ordered, :code, :label, params[:status]),
              include_blank: "すべて", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div class="col-span-full flex items-center justify-between pt-1">
        <span class="text-sm text-slate-500">全 <%= number_with_delimiter(@pagy.count) %> 件</span>
        <div class="flex gap-2">
          <%= link_to "クリア", admin_orders_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50" %>
          <%= submit_tag "検索", class: "rounded-md bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <th class="px-4 py-3">案件番号</th>
          <th class="px-4 py-3">契約顧客</th>
          <th class="px-4 py-3">販売代理店</th>
          <th class="px-4 py-3">受注日</th>
          <th class="px-4 py-3">案件ステータス</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @orders.empty? %>
          <tr>
            <td colspan="6" class="px-4 py-8 text-center text-slate-500">該当する案件が見つかりません</td>
          </tr>
        <% end %>
        <% @orders.each do |order| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-mono text-slate-600"><%= link_to order.order_number, admin_order_path(order), class: "hover:underline" %></td>
            <td class="px-4 py-3 font-medium text-slate-800"><%= link_to order.customer.name, admin_customer_path(order.customer), class: "hover:underline" %></td>
            <td class="px-4 py-3 text-slate-600"><%= order.agency.name %></td>
            <td class="px-4 py-3 text-slate-600"><%= order.ordered_at&.to_date || "—" %></td>
            <td class="px-4 py-3">
              <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= order_status_badge_class(order.status) %>">
                <%= order_status_label(order.status) %>
              </span>
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "詳細", admin_order_path(order), class: "text-indigo-600 hover:underline" %>
              <% if policy(order).update? %>
                <%= link_to "編集", edit_admin_order_path(order), class: "ml-3 text-indigo-600 hover:underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
