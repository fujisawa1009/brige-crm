<% content_for :page_title, "営業資料" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900">営業資料</h2>
      <p class="text-sm text-slate-500">代理店向けに公開する営業資料を管理します。</p>
    </div>
    <% if policy(SalesMaterial).create? %>
      <%= link_to "新規作成", new_admin_sales_material_path,
            class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <th class="px-4 py-3">タイトル</th>
          <th class="px-4 py-3">カテゴリ</th>
          <th class="px-4 py-3">状態</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @sales_materials.empty? %>
          <tr>
            <td colspan="4" class="px-4 py-8 text-center text-slate-500">営業資料が登録されていません</td>
          </tr>
        <% end %>
        <% @sales_materials.each do |material| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-medium text-slate-800"><%= link_to material.title, admin_sales_material_path(material), class: "hover:underline" %></td>
            <td class="px-4 py-3 text-slate-600"><%= material.category.presence || "—" %></td>
            <td class="px-4 py-3">
              <% if material.is_published? %>
                <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">公開</span>
              <% else %>
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">非公開</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "詳細", admin_sales_material_path(material), class: "text-indigo-600 hover:underline" %>
              <% if policy(material).update? %>
                <%= link_to "編集", edit_admin_sales_material_path(material), class: "ml-3 text-indigo-600 hover:underline" %>
              <% end %>
              <% if policy(material).destroy? %>
                <%= button_to "削除", admin_sales_material_path(material), method: :delete,
                      form: { data: { turbo_confirm: "#{material.title} を削除しますか？" }, class: "inline ml-3" },
                      class: "text-red-600 hover:underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
