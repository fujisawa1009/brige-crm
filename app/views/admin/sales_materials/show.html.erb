<% content_for :page_title, "営業資料詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-bold text-slate-900"><%= @sales_material.title %></h2>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_sales_materials_path,
            class: "btn-secondary" %>
      <% if policy(@sales_material).update? %>
        <%= link_to "編集", edit_admin_sales_material_path(@sales_material),
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">カテゴリ</dt>
        <dd class="mt-1 text-slate-800"><%= @sales_material.category.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">状態</dt>
        <dd class="mt-1">
          <% if @sales_material.is_published? %>
            <%= badge_tag "公開", color: "green" %>
          <% else %>
            <%= badge_tag "非公開", color: "slate-muted" %>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">ファイルパス</dt>
        <dd class="mt-1 font-mono text-slate-800"><%= @sales_material.file_path.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">元ファイル名</dt>
        <dd class="mt-1 text-slate-800"><%= @sales_material.original_file_name.presence || "—" %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs text-slate-500">説明</dt>
        <dd class="mt-1 text-slate-800"><%= @sales_material.description.presence || "—" %></dd>
      </div>
    </dl>
  </div>

  <% if policy(@sales_material).destroy? %>
    <div>
      <%= button_to "この営業資料を削除", admin_sales_material_path(@sales_material), method: :delete,
            form: { data: { turbo_confirm: "#{@sales_material.title} を削除しますか？" } },
            class: "btn-danger" %>
    </div>
  <% end %>
</div>
