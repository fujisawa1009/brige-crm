<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @sales_material.title %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">カテゴリ</dt><dd><%= @sales_material.category %></dd>
    <dt class="font-bold">説明</dt><dd><%= @sales_material.description %></dd>
    <dt class="font-bold">ファイルパス</dt><dd><%= @sales_material.file_path %></dd>
    <dt class="font-bold">公開</dt><dd><%= @sales_material.is_published %></dd>
  </dl>
  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_sales_materials_path, class: "underline" %>
    <% if policy(@sales_material).update? %><%= link_to "編集", edit_admin_sales_material_path(@sales_material), class: "underline" %><% end %>
    <% if policy(@sales_material).destroy? %>
      <%= button_to "削除", admin_sales_material_path(@sales_material), method: :delete, form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
