<%= form_with model: sales_material, url: url, class: "flex flex-col gap-3 max-w-md" do |f| %>
  <% if sales_material.errors.any? %><div class="text-red-700"><%= sales_material.errors.full_messages.to_sentence %></div><% end %>
  <div><%= f.label :title, "タイトル" %><%= f.text_field :title, class: "border rounded px-2 py-1 w-full" %></div>
  <div>
    <%= f.label :category, "カテゴリ" %>
    <%= f.select :category, SalesMaterial::CATEGORIES, { include_blank: true }, class: "border rounded px-2 py-1 w-full" %>
  </div>
  <div><%= f.label :description, "説明" %><%= f.text_area :description, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :file_path, "ファイルパス/URL" %><%= f.text_field :file_path, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :original_file_name, "元ファイル名" %><%= f.text_field :original_file_name, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :file_size, "ファイルサイズ(byte)" %><%= f.number_field :file_size, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :mime_type, "MIMEタイプ" %><%= f.text_field :mime_type, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :sort_order, "表示順" %><%= f.number_field :sort_order, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :is_published, "公開" %><%= f.check_box :is_published %></div>
  <%= f.submit "保存", class: "bg-blue-600 text-white rounded px-4 py-2 w-fit" %>
<% end %>
