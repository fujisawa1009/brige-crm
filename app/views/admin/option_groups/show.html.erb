<% content_for :page_title, "選択肢グループ詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900"><%= @option_group.label %></h2>
      <p class="text-sm text-slate-500 font-mono"><%= @option_group.key %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_option_groups_path,
            class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% if policy(@option_group).update? %>
        <%= link_to "編集", edit_admin_option_group_path(@option_group),
              class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">状態</dt>
        <dd class="mt-1"><%= active_badge(@option_group.is_active?) %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs text-slate-500">説明</dt>
        <dd class="mt-1 text-slate-800"><%= @option_group.description.presence || "—" %></dd>
      </div>
    </dl>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-center justify-between">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">選択肢（ルート・<%= @option_group.root_values.size %>件）</h3>
      <% if policy(OptionValue).create? %>
        <%= link_to "選択肢を追加", new_admin_option_value_path, class: "text-sm text-indigo-600 hover:underline" %>
      <% end %>
    </div>
    <% if @option_group.root_values.any? %>
      <ul class="divide-y divide-slate-100">
        <% @option_group.root_values.each do |value| %>
          <li class="flex items-center justify-between py-2 text-sm">
            <%= link_to value.label, admin_option_value_path(value), class: "font-medium text-slate-800 hover:underline" %>
            <% if value.children.any? %>
              <span class="text-xs text-slate-500">子選択肢 <%= value.children.size %>件</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-500">選択肢はまだ登録されていません。</p>
    <% end %>
  </div>

  <% if policy(@option_group).destroy? %>
    <div>
      <%= button_to "この選択肢グループを削除", admin_option_group_path(@option_group), method: :delete,
            form: { data: { turbo_confirm: "#{@option_group.label} を削除しますか？" } },
            class: "rounded-md border border-red-300 bg-red-50 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-100" %>
    </div>
  <% end %>
</div>
