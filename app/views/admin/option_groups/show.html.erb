<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @option_group.label %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">キー</dt><dd><%= @option_group.key %></dd>
    <dt class="font-bold">説明</dt><dd><%= @option_group.description %></dd>
  </dl>
  <h2 class="text-lg font-bold">選択肢（ルート）</h2>
  <ul class="list-disc list-inside">
    <% @option_group.root_values.each do |value| %>
      <li><%= link_to value.label, admin_option_value_path(value) %></li>
    <% end %>
  </ul>
  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_option_groups_path, class: "underline" %>
    <% if policy(@option_group).update? %><%= link_to "編集", edit_admin_option_group_path(@option_group), class: "underline" %><% end %>
    <% if policy(@option_group).destroy? %>
      <%= button_to "削除", admin_option_group_path(@option_group), method: :delete, form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
