<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold">選択肢グループ</h1>
  <% if policy(OptionGroup).create? %><%= link_to "新規作成", new_admin_option_group_path, class: "underline w-fit" %><% end %>
  <table class="border-collapse w-full text-sm">
    <thead><tr><th class="border px-2 py-1 text-left">キー</th><th class="border px-2 py-1 text-left">表示名</th></tr></thead>
    <tbody>
      <% @option_groups.each do |group| %>
        <tr>
          <td class="border px-2 py-1"><%= group.key %></td>
          <td class="border px-2 py-1"><%= link_to group.label, admin_option_group_path(group) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
