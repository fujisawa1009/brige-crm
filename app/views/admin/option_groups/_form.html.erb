<%= form_with model: option_group, url: url, class: "flex flex-col gap-3 max-w-md" do |f| %>
  <% if option_group.errors.any? %><div class="text-red-700"><%= option_group.errors.full_messages.to_sentence %></div><% end %>
  <div><%= f.label :key, "システムキー" %><%= f.text_field :key, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :label, "表示名" %><%= f.text_field :label, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :description, "説明" %><%= f.text_area :description, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :sort_order, "表示順" %><%= f.number_field :sort_order, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :is_active, "有効" %><%= f.check_box :is_active %></div>
  <%= f.submit "保存", class: "bg-blue-600 text-white rounded px-4 py-2 w-fit" %>
<% end %>
