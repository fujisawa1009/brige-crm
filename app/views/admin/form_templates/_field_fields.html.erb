<%# ローカル変数: f（FormField用のfields_forビルダー） %>
<div data-nested-form-target="item" class="border rounded p-2 flex flex-col gap-2 bg-white text-sm">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :_destroy %>

  <div class="grid grid-cols-2 gap-2">
    <div>
      <%= f.label :field_key, "キー（英小文字・数字・_）" %>
      <%= f.text_field :field_key, class: "border rounded px-2 py-1 w-full" %>
    </div>
    <div>
      <%= f.label :label, "表示ラベル" %>
      <%= f.text_field :label, class: "border rounded px-2 py-1 w-full" %>
    </div>
    <div>
      <%= f.label :field_type, "入力形式" %>
      <%= f.select :field_type, FormField::FIELD_TYPES, {}, class: "border rounded px-2 py-1 w-full" %>
    </div>
    <div>
      <%= f.label :target_table, "反映先モデル" %>
      <%= f.select :target_table, FormField::TARGET_TABLES, {}, class: "border rounded px-2 py-1 w-full" %>
    </div>
    <div>
      <%= f.label :target_column, "反映先カラム（例: name / product_option_ids）" %>
      <%= f.text_field :target_column, class: "border rounded px-2 py-1 w-full" %>
    </div>
    <div>
      <%= f.label :sort_order, "表示順" %>
      <%= f.number_field :sort_order, class: "border rounded px-2 py-1 w-full" %>
    </div>
    <div class="flex items-center gap-2">
      <%= f.check_box :required %>
      <%= f.label :required, "必須" %>
    </div>
    <div>
      <%= f.label :lock_after_status, "編集ロック閾ステータス（order_statuses.code。任意）" %>
      <%= f.text_field :lock_after_status, class: "border rounded px-2 py-1 w-full" %>
    </div>
    <div class="col-span-2">
      <%= f.label :editable_by_tier, "編集可能区分" %>
      <%= f.collection_check_boxes :editable_by_tier, FormField::TIERS, :itself, :itself do |b| %>
        <span class="mr-3 inline-flex items-center gap-1"><%= b.check_box %> <%= b.label %></span>
      <% end %>
    </div>
    <div class="col-span-2">
      <%= f.label :input_options_json, "選択肢（JSON。例: {\"choices\":[[\"yes\",\"はい\"],[\"no\",\"いいえ\"]]}）" %>
      <%= f.text_area :input_options_json, value: f.object.input_options.presence&.to_json,
            class: "border rounded px-2 py-1 w-full font-mono", rows: 2 %>
    </div>
    <div class="col-span-2">
      <%= f.label :validation_rules_json, "検証ルール（JSON。例: {\"max_length\":100}）" %>
      <%= f.text_area :validation_rules_json, value: f.object.validation_rules.presence&.to_json,
            class: "border rounded px-2 py-1 w-full font-mono", rows: 2 %>
    </div>
  </div>
  <button type="button" data-action="nested-form#remove" class="text-red-700 underline w-fit">フィールドを削除</button>
</div>
