<%= form_with model: form_template, url: url, scope: :form_template, class: "flex flex-col gap-6 max-w-4xl" do |f| %>
  <% if form_template.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= form_template.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <div class="flex flex-col gap-4 max-w-md">
      <div>
        <%= f.label :product_id, "対象商材", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :product_id, Product.order(:name), :id, :name,
              { include_blank: true }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :name, "テンプレート名", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.text_field :name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div class="flex items-center gap-2">
        <%= f.check_box :is_active, class: "h-4 w-4 rounded border-slate-300" %>
        <%= f.label :is_active, "有効", class: "text-sm font-medium text-slate-700" %>
      </div>
    </div>
  </div>

  <%# 04 R3タスク6: ステップの動的追加・削除（nested-form Stimulusコントローラ）。 %>
  <div data-controller="nested-form" data-nested-form-placeholder-value="NEW_STEP_RECORD"
       class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">ステップ</h3>

    <div data-nested-form-target="container" class="flex flex-col gap-4">
      <%= f.fields_for :form_steps do |step_f| %>
        <%= render "step_fields", f: step_f %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :form_steps, FormStep.new, child_index: "NEW_STEP_RECORD" do |step_f| %>
        <%= render "step_fields", f: step_f %>
      <% end %>
    </template>

    <button type="button" data-action="nested-form#add"
            class="mt-4 rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">ステップを追加</button>
  </div>

  <div class="flex gap-2">
    <%= f.submit "保存", class: "btn-primary" %>
    <%= link_to "キャンセル", admin_form_templates_path, class: "btn-secondary" %>
  </div>
<% end %>
