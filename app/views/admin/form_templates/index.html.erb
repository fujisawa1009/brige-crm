<% content_for :page_title, "フォームテンプレート" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900">フォームテンプレート</h2>
      <p class="text-sm text-slate-500">商材ごとの申込フォーム（ステップ・入力項目）を管理します。</p>
    </div>
    <% if policy(FormTemplate).create? %>
      <%= link_to "新規作成", new_admin_form_template_path,
            class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <th class="px-4 py-3">商材</th>
          <th class="px-4 py-3">テンプレート名</th>
          <th class="px-4 py-3">状態</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @form_templates.empty? %>
          <tr>
            <td colspan="4" class="px-4 py-8 text-center text-slate-500">フォームテンプレートが登録されていません</td>
          </tr>
        <% end %>
        <% @form_templates.each do |form_template| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 text-slate-600"><%= link_to form_template.product.name, admin_product_path(form_template.product), class: "hover:underline" %></td>
            <td class="px-4 py-3 font-medium text-slate-800"><%= link_to form_template.name, admin_form_template_path(form_template), class: "hover:underline" %></td>
            <td class="px-4 py-3"><%= active_badge(form_template.is_active?) %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "詳細", admin_form_template_path(form_template), class: "text-indigo-600 hover:underline" %>
              <% if policy(form_template).update? %>
                <%= link_to "編集", edit_admin_form_template_path(form_template), class: "ml-3 text-indigo-600 hover:underline" %>
              <% end %>
              <% if policy(form_template).destroy? %>
                <%= button_to "削除", admin_form_template_path(form_template), method: :delete,
                      form: { data: { turbo_confirm: "#{form_template.name} を削除しますか？" }, class: "inline ml-3" },
                      class: "text-red-600 hover:underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
