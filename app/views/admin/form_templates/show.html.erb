<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @form_template.name %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">商材</dt><dd><%= @form_template.product.name %></dd>
    <dt class="font-bold">有効</dt><dd><%= @form_template.is_active? %></dd>
  </dl>

  <div class="flex flex-col gap-4">
    <% @form_template.form_steps.each do |step| %>
      <div class="border rounded p-3">
        <h2 class="font-bold">ステップ<%= step.step_number %>: <%= step.name %></h2>
        <table class="border-collapse w-full text-sm mt-2">
          <thead>
            <tr>
              <th class="border px-2 py-1 text-left">キー</th>
              <th class="border px-2 py-1 text-left">ラベル</th>
              <th class="border px-2 py-1 text-left">入力形式</th>
              <th class="border px-2 py-1 text-left">反映先</th>
              <th class="border px-2 py-1 text-left">必須</th>
              <th class="border px-2 py-1 text-left">編集可能区分</th>
            </tr>
          </thead>
          <tbody>
            <% step.form_fields.ordered.each do |field| %>
              <tr>
                <td class="border px-2 py-1"><%= field.field_key %></td>
                <td class="border px-2 py-1"><%= field.label %></td>
                <td class="border px-2 py-1"><%= field.field_type %></td>
                <td class="border px-2 py-1"><%= field.target_table %>.<%= field.target_column %></td>
                <td class="border px-2 py-1"><%= field.required? %></td>
                <td class="border px-2 py-1"><%= field.editable_by_tier.join(", ") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_form_templates_path, class: "underline" %>
    <% if policy(@form_template).update? %>
      <%= link_to "編集", edit_admin_form_template_path(@form_template), class: "underline" %>
    <% end %>
    <% if policy(@form_template).destroy? %>
      <%= button_to "削除", admin_form_template_path(@form_template), method: :delete,
            form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
