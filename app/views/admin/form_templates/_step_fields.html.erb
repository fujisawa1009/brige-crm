<%# ローカル変数: f（FormStep用のfields_forビルダー） %>
<div data-nested-form-target="item" class="flex flex-col gap-3 rounded-lg border border-slate-200 bg-slate-50 p-4">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :_destroy %>

  <div class="flex items-end gap-3">
    <div>
      <%= f.label :step_number, "ステップ番号", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.number_field :step_number, class: "w-24 rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="flex-1">
      <%= f.label :name, "ステップ名", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <button type="button" data-action="nested-form#remove" class="text-sm font-medium text-red-600 hover:underline">ステップを削除</button>
  </div>

  <%# 04 R3タスク6: フィールドの動的追加・削除。ステップと同じnested-formコントローラを
      入れ子で使う（Stimulusはターゲット解決を最も近い祖先コントローラでスコープするため、
      外側のステップ用コントローラのcontainer/templateを誤って掴まない）。 %>
  <div data-controller="nested-form" data-nested-form-placeholder-value="NEW_FIELD_RECORD"
       class="flex flex-col gap-3 border-l-2 border-slate-200 pl-4">
    <h4 class="text-xs font-semibold uppercase tracking-wide text-slate-500">フィールド</h4>

    <div data-nested-form-target="container" class="flex flex-col gap-3">
      <%= f.fields_for :form_fields do |field_f| %>
        <%= render "field_fields", f: field_f %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :form_fields, FormField.new, child_index: "NEW_FIELD_RECORD" do |field_f| %>
        <%= render "field_fields", f: field_f %>
      <% end %>
    </template>

    <button type="button" data-action="nested-form#add"
            class="w-fit rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">フィールドを追加</button>
  </div>
</div>
