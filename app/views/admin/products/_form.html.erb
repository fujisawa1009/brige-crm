<%= form_with model: product, url: url, class: "flex flex-col gap-3 max-w-md" do |f| %>
  <% if product.errors.any? %>
    <div class="text-red-700"><%= product.errors.full_messages.to_sentence %></div>
  <% end %>
  <div><%= f.label :name, "商材名" %><%= f.text_field :name, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :code, "コード" %><%= f.text_field :code, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :description, "説明" %><%= f.text_area :description, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :is_active, "有効" %><%= f.check_box :is_active %></div>
  <%= f.submit "保存", class: "bg-blue-600 text-white rounded px-4 py-2 w-fit" %>
<% end %>
