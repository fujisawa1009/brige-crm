<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @product.name %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">コード</dt><dd><%= @product.code %></dd>
    <dt class="font-bold">説明</dt><dd><%= @product.description %></dd>
    <dt class="font-bold">有効</dt><dd><%= @product.is_active %></dd>
  </dl>
  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_products_path, class: "underline" %>
    <% if policy(@product).update? %><%= link_to "編集", edit_admin_product_path(@product), class: "underline" %><% end %>
    <% if policy(@product).destroy? %>
      <%= button_to "削除", admin_product_path(@product), method: :delete, form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
