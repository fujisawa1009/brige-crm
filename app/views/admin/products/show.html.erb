<% content_for :page_title, "商材詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900"><%= @product.name %></h2>
      <p class="text-sm text-slate-500 font-mono"><%= @product.code %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_products_path,
            class: "btn-secondary" %>
      <% if policy(@product).update? %>
        <%= link_to "編集", edit_admin_product_path(@product),
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">状態</dt>
        <dd class="mt-1"><%= active_badge(@product.is_active?) %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs text-slate-500">説明</dt>
        <dd class="mt-1 text-slate-800"><%= @product.description.presence || "—" %></dd>
      </div>
    </dl>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">プラン（<%= @product.plans.size %>件）</h3>
      <ul class="space-y-1 text-sm">
        <% @product.plans.each do |plan| %>
          <li><%= link_to plan.name, admin_plan_path(plan), class: "text-slate-700 hover:underline" %></li>
        <% end %>
      </ul>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">初期費用（<%= @product.product_initial_fees.size %>件）</h3>
      <ul class="space-y-1 text-sm">
        <% @product.product_initial_fees.each do |fee| %>
          <li><%= link_to fee.name, admin_product_initial_fee_path(fee), class: "text-slate-700 hover:underline" %></li>
        <% end %>
      </ul>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">オプション（<%= @product.product_options.size %>件）</h3>
      <ul class="space-y-1 text-sm">
        <% @product.product_options.each do |option| %>
          <li><%= link_to option.name, admin_product_option_path(option), class: "text-slate-700 hover:underline" %></li>
        <% end %>
      </ul>
    </div>
  </div>

  <% if policy(@product).destroy? %>
    <div>
      <%= button_to "この商材を削除", admin_product_path(@product), method: :delete,
            form: { data: { turbo_confirm: "#{@product.name} を削除しますか？" } },
            class: "btn-danger" %>
    </div>
  <% end %>
</div>
