<% content_for :page_title, "問い合わせ新規作成" %>

<div class="flex flex-col gap-4">
  <h2 class="text-xl font-bold text-slate-900">問い合わせ新規作成</h2>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= form_with model: @inquiry, url: admin_inquiries_path, class: "flex flex-col gap-4 max-w-md" do |f| %>
      <% if @inquiry.errors.any? %>
        <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= @inquiry.errors.full_messages.to_sentence %></div>
      <% end %>

      <div>
        <%= f.label :order_id, "案件", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :order_id, @orders, :id, :order_number,
              { include_blank: true }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :title, "タイトル", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.text_field :title, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :category, "掲示板種別", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.select :category, Inquiry::CATEGORIES, {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <%# E10: 次回対応者（部門）。旧システムの「営業担当/FT管理/FT運用/FTコール/なし」に相当し、
          選んだ部門の宛先グループへ通知が飛ぶ。未選択（なし）ならステータス×ルートの既定宛先へ送る。 %>
      <div>
        <%= f.label :next_responder_group_id, "次回対応者（任意）", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= f.collection_select :next_responder_group_id, @recipient_groups, :id, :name,
              { include_blank: "なし（既定の宛先へ送る）" }, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :first_message_body, "本文", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= text_area_tag "inquiry[first_message_body]", nil, rows: 4, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <%# R6-5: 社内外公開制御。既定は両方公開（見せる）で、社内限定にしたい場合だけ外す運用
          （is_visible_to_agent/is_visible_to_customerのカラムdefault:trueと揃える）。 %>
      <div class="flex items-center gap-2">
        <%= f.check_box :is_visible_to_agent, class: "rounded border-slate-300" %>
        <%= f.label :is_visible_to_agent, "代理店へ公開する", class: "text-sm text-slate-700" %>
      </div>
      <div class="flex items-center gap-2">
        <%= f.check_box :is_visible_to_customer, class: "rounded border-slate-300" %>
        <%= f.label :is_visible_to_customer, "顧客へ公開する", class: "text-sm text-slate-700" %>
      </div>

      <div class="flex gap-2 pt-2">
        <%= f.submit "作成", class: "btn-primary" %>
        <%= link_to "キャンセル", admin_inquiries_path, class: "btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
