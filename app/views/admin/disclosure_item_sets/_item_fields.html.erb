<%# ローカル変数: f（DisclosureItem用のfields_forビルダー） %>
<div data-nested-form-target="item" class="flex flex-col gap-3 rounded-lg border border-slate-200 bg-slate-50 p-4">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :_destroy %>

  <div class="flex items-end gap-3">
    <div>
      <%= f.label :sort_order, "表示順", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.number_field :sort_order, class: "w-24 rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="flex-1">
      <%= f.label :title, "見出し", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :title, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="flex items-center gap-2 pb-2">
      <%= f.check_box :is_required, class: "h-4 w-4 rounded border-slate-300" %>
      <%= f.label :is_required, "必須", class: "text-sm font-medium text-slate-700" %>
    </div>
    <button type="button" data-action="nested-form#remove" class="pb-2 text-sm font-medium text-red-600 hover:underline">削除</button>
  </div>
  <div>
    <%= f.label :body, "本文", class: "mb-1 block text-sm font-medium text-slate-700" %>
    <%= f.text_area :body, rows: 3, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  </div>
</div>
