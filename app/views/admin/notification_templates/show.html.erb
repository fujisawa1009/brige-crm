<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @notification_template.name %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">種別</dt><dd><%= NotificationTemplate::TEMPLATE_TYPES[@notification_template.template_type] %></dd>
    <dt class="font-bold">件名</dt><dd><%= @notification_template.subject %></dd>
    <dt class="font-bold">本文</dt><dd><%= simple_format(@notification_template.body) %></dd>
  </dl>
  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_notification_templates_path, class: "underline" %>
    <% if policy(@notification_template).update? %><%= link_to "編集", edit_admin_notification_template_path(@notification_template), class: "underline" %><% end %>
    <% if policy(@notification_template).destroy? %>
      <%= button_to "削除", admin_notification_template_path(@notification_template), method: :delete, form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
