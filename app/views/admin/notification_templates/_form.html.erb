<%= form_with model: notification_template, url: url, class: "flex flex-col gap-3 max-w-md" do |f| %>
  <% if notification_template.errors.any? %><div class="text-red-700"><%= notification_template.errors.full_messages.to_sentence %></div><% end %>
  <div><%= f.label :name, "テンプレート名" %><%= f.text_field :name, class: "border rounded px-2 py-1 w-full" %></div>
  <div>
    <%= f.label :template_type, "種別" %>
    <%= f.select :template_type, NotificationTemplate::TEMPLATE_TYPES.invert, {}, class: "border rounded px-2 py-1 w-full" %>
  </div>
  <div><%= f.label :subject, "件名" %><%= f.text_field :subject, class: "border rounded px-2 py-1 w-full" %></div>
  <div><%= f.label :body, "本文" %><%= f.text_area :body, rows: 6, class: "border rounded px-2 py-1 w-full" %></div>
  <%= f.submit "保存", class: "bg-blue-600 text-white rounded px-4 py-2 w-fit" %>
<% end %>
