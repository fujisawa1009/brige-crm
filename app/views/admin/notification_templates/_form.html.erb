<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <%= form_with model: notification_template, url: url, class: "flex flex-col gap-4 max-w-md" do |f| %>
    <% if notification_template.errors.any? %>
      <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= notification_template.errors.full_messages.to_sentence %></div>
    <% end %>

    <div>
      <%= f.label :name, "テンプレート名", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :name, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :template_type, "種別", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.select :template_type, NotificationTemplate::TEMPLATE_TYPES.invert, {},
            class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :subject, "件名", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :subject, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :body, "本文", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_area :body, rows: 6, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>

    <div class="flex gap-2 pt-2">
      <%= f.submit "保存", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
      <%= link_to "キャンセル", admin_notification_templates_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50" %>
    </div>
  <% end %>
</div>
