<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <%= form_with model: inquiry_recipient_route, url: url, class: "flex flex-col gap-4 max-w-md" do |f| %>
    <% if inquiry_recipient_route.errors.any? %>
      <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= inquiry_recipient_route.errors.full_messages.to_sentence %></div>
    <% end %>

    <div>
      <%= f.label :category, "掲示板種別", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.select :category, Inquiry::CATEGORIES, {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :status_code, "ステータス", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :status_code, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :recipient_group_id, "宛先グループ", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.collection_select :recipient_group_id, RecipientGroup.active, :id, :name,
            {}, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>

    <div class="flex gap-2 pt-2">
      <%= f.submit "保存", class: "btn-primary" %>
      <%= link_to "キャンセル", admin_inquiry_recipient_routes_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
