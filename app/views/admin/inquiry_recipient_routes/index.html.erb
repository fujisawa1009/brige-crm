<% content_for :page_title, "問い合わせ宛先ルート" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900">問い合わせ宛先ルート</h2>
      <p class="text-sm text-slate-500">掲示板種別×ステータスごとの通知先グループを管理します。</p>
    </div>
    <% if policy(InquiryRecipientRoute).create? %>
      <%= link_to "新規作成", new_admin_inquiry_recipient_route_path,
            class: "btn-primary" %>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_inquiry_recipient_routes_path, method: :get, class: "flex flex-wrap items-end gap-3" do %>
      <div>
        <label class="mb-1 block text-xs font-medium text-slate-500">掲示板種別</label>
        <%= select_tag :category, options_for_select(Inquiry::CATEGORIES, params[:category]),
              include_blank: "すべて", class: "w-56 rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <span class="ml-auto text-sm text-slate-500">全 <%= number_with_delimiter(@pagy.count) %> 件</span>
      <%= link_to "クリア", admin_inquiry_recipient_routes_path, class: "btn-secondary" %>
      <%= submit_tag "検索", class: "rounded-md bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <th class="px-4 py-3">掲示板種別</th>
          <th class="px-4 py-3">ステータス</th>
          <th class="px-4 py-3">宛先グループ</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @inquiry_recipient_routes.empty? %>
          <tr>
            <td colspan="4" class="px-4 py-8 text-center text-slate-500">該当するルーティングが見つかりません</td>
          </tr>
        <% end %>
        <% @inquiry_recipient_routes.each do |route| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3">
              <%= inquiry_category_badge(route.category) %>
            </td>
            <td class="px-4 py-3 font-medium text-slate-800"><%= link_to route.status_code, admin_inquiry_recipient_route_path(route), class: "hover:underline" %></td>
            <td class="px-4 py-3 text-slate-600"><%= route.recipient_group.name %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "詳細", admin_inquiry_recipient_route_path(route), class: "text-indigo-600 hover:underline" %>
              <% if policy(route).update? %>
                <%= link_to "編集", edit_admin_inquiry_recipient_route_path(route), class: "ml-3 text-indigo-600 hover:underline" %>
              <% end %>
              <% if policy(route).destroy? %>
                <%= button_to "削除", admin_inquiry_recipient_route_path(route), method: :delete,
                      form: { data: { turbo_confirm: "#{route.category} / #{route.status_code} のルーティングを削除しますか？" }, class: "inline ml-3" },
                      class: "text-red-600 hover:underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
</div>
