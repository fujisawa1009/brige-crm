<% content_for :page_title, "問い合わせ宛先ルート詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900"><%= @inquiry_recipient_route.status_code %></h2>
      <p class="text-sm text-slate-500"><%= @inquiry_recipient_route.category %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_inquiry_recipient_routes_path,
            class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% if policy(@inquiry_recipient_route).update? %>
        <%= link_to "編集", edit_admin_inquiry_recipient_route_path(@inquiry_recipient_route),
              class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">掲示板種別</dt>
        <dd class="mt-1">
          <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= inquiry_category_badge_class(@inquiry_recipient_route.category) %>"><%= @inquiry_recipient_route.category %></span>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">ステータス</dt>
        <dd class="mt-1 text-slate-800"><%= @inquiry_recipient_route.status_code %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs text-slate-500">宛先グループ</dt>
        <dd class="mt-1 text-slate-800"><%= @inquiry_recipient_route.recipient_group.name %></dd>
      </div>
    </dl>
  </div>

  <% if policy(@inquiry_recipient_route).destroy? %>
    <div>
      <%= button_to "このルーティングを削除", admin_inquiry_recipient_route_path(@inquiry_recipient_route), method: :delete,
            form: { data: { turbo_confirm: "#{@inquiry_recipient_route.category} / #{@inquiry_recipient_route.status_code} のルーティングを削除しますか？" } },
            class: "rounded-md border border-red-300 bg-red-50 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-100" %>
    </div>
  <% end %>
</div>
