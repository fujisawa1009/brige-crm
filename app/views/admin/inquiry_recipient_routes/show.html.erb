<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @inquiry_recipient_route.category %> / <%= @inquiry_recipient_route.status_code %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">宛先グループ</dt><dd><%= @inquiry_recipient_route.recipient_group.name %></dd>
  </dl>
  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_inquiry_recipient_routes_path, class: "underline" %>
    <% if policy(@inquiry_recipient_route).update? %><%= link_to "編集", edit_admin_inquiry_recipient_route_path(@inquiry_recipient_route), class: "underline" %><% end %>
    <% if policy(@inquiry_recipient_route).destroy? %>
      <%= button_to "削除", admin_inquiry_recipient_route_path(@inquiry_recipient_route), method: :delete, form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
