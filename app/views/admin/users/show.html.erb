<% content_for :page_title, "ユーザー詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900"><%= @user.name %></h2>
      <p class="text-sm text-slate-500"><%= @user.email %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_users_path,
            class: "btn-secondary" %>
      <% if policy(@user).update? %>
        <%= link_to "編集", edit_admin_user_path(@user),
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">氏名</dt>
        <dd class="mt-1 font-medium text-slate-800"><%= @user.name %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">メールアドレス</dt>
        <dd class="mt-1 text-slate-800"><%= @user.email %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">状態</dt>
        <dd class="mt-1"><%= active_badge(@user.is_active?) %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">アカウント種別</dt>
        <dd class="mt-1">
          <%= user_account_type_badge(@user) %>
        </dd>
      </div>
      <% if @user.agency %>
        <div>
          <dt class="text-xs text-slate-500">所属代理店</dt>
          <dd class="mt-1"><%= link_to "#{@user.agency.name}（#{@user.agency.agency_code}）", admin_agency_path(@user.agency), class: "text-indigo-600 hover:underline" %></dd>
        </div>
      <% elsif @user.agency_group %>
        <div>
          <dt class="text-xs text-slate-500">所属代理店グループ</dt>
          <dd class="mt-1"><%= link_to "#{@user.agency_group.name}（#{@user.agency_group.group_code}）", admin_agency_group_path(@user.agency_group), class: "text-indigo-600 hover:underline" %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">ロール</h3>
    <% if @user.system_roles.any? %>
      <div class="flex flex-wrap gap-2">
        <% @user.system_roles.each do |role| %>
          <span class="rounded-full border border-slate-200 px-3 py-1 text-sm text-slate-700"><%= role.display_name.presence || role.name %></span>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-slate-500">ロールが割り当てられていません。</p>
    <% end %>
  </div>

  <% if policy(@user).destroy? %>
    <div>
      <%= button_to "このユーザーを削除", admin_user_path(@user), method: :delete,
            form: { data: { turbo_confirm: "#{@user.name} を削除しますか？" } },
            class: "btn-danger" %>
    </div>
  <% end %>
</div>
