<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @user.name %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">メール</dt><dd><%= @user.email %></dd>
    <dt class="font-bold">所属代理店</dt><dd><%= @user.agency&.name %></dd>
    <dt class="font-bold">所属グループ</dt><dd><%= @user.agency_group&.name %></dd>
    <dt class="font-bold">有効</dt><dd><%= @user.is_active? ? "有効" : "無効" %></dd>
  </dl>

  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_users_path, class: "underline" %>
    <% if policy(@user).update? %>
      <%= link_to "編集", edit_admin_user_path(@user), class: "underline" %>
    <% end %>
    <% if policy(@user).destroy? %>
      <%= button_to "削除", admin_user_path(@user), method: :delete,
            form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
