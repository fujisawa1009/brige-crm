<%= form_with model: user, url: url, class: "flex flex-col gap-3 max-w-md" do |f| %>
  <% if user.errors.any? %>
    <div class="text-red-700"><%= user.errors.full_messages.to_sentence %></div>
  <% end %>

  <div>
    <%= f.label :name, "氏名" %>
    <%= f.text_field :name, class: "border rounded px-2 py-1 w-full" %>
  </div>
  <div>
    <%= f.label :email, "メール" %>
    <%= f.text_field :email, class: "border rounded px-2 py-1 w-full" %>
  </div>

  <% if user.new_record? %>
    <div>
      <%= f.label :password, "初期パスワード" %>
      <%= f.password_field :password, class: "border rounded px-2 py-1 w-full" %>
    </div>
    <div>
      <%= f.label :password_confirmation, "初期パスワード（確認）" %>
      <%= f.password_field :password_confirmation, class: "border rounded px-2 py-1 w-full" %>
    </div>
  <% end %>

  <% if policy(user).staff_scope? %>
    <div>
      <%= f.label :agency_group_id, "所属グループ（内部/代理店グループ担当者のみ）" %>
      <%= f.collection_select :agency_group_id, AgencyGroup.order(:name), :id, :name,
            { include_blank: true }, class: "border rounded px-2 py-1 w-full" %>
    </div>
    <div>
      <%= f.label :agency_id, "所属代理店（代理店担当者のみ）" %>
      <%= f.collection_select :agency_id, Agency.order(:name), :id, :name,
            { include_blank: true }, class: "border rounded px-2 py-1 w-full" %>
    </div>
  <% end %>
  <div>
    <%= f.label :is_active, "有効" %>
    <%= f.check_box :is_active %>
  </div>

  <%= f.submit "保存", class: "bg-blue-600 text-white rounded px-4 py-2 w-fit" %>
<% end %>
