<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold">ユーザー</h1>
  <div class="flex gap-3">
    <% if policy(User).create? %>
      <%= link_to "新規作成", new_admin_user_path, class: "underline w-fit" %>
      <%= link_to "CSV一括アップロード", import_admin_users_path, class: "underline w-fit" %>
    <% end %>
  </div>

  <table class="border-collapse w-full text-sm">
    <thead>
      <tr>
        <th class="border px-2 py-1 text-left">メール</th>
        <th class="border px-2 py-1 text-left">氏名</th>
        <th class="border px-2 py-1 text-left">所属</th>
        <th class="border px-2 py-1">有効</th>
        <th class="border px-2 py-1"></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td class="border px-2 py-1"><%= link_to user.email, admin_user_path(user) %></td>
          <td class="border px-2 py-1"><%= user.name %></td>
          <td class="border px-2 py-1"><%= user.agency&.name || user.agency_group&.name || "社内" %></td>
          <td class="border px-2 py-1 text-center"><%= user.is_active? ? "✓" : "" %></td>
          <td class="border px-2 py-1"></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
