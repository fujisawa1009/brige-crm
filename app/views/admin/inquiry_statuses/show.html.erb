<% content_for :page_title, "問い合わせステータス詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900"><%= @inquiry_status.label %></h2>
      <p class="text-sm text-slate-500 font-mono"><%= @inquiry_status.code %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_inquiry_statuses_path,
            class: "btn-secondary" %>
      <% if policy(@inquiry_status).update? %>
        <%= link_to "編集", edit_admin_inquiry_status_path(@inquiry_status),
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">掲示板種別</dt>
        <dd class="mt-1">
          <%= inquiry_category_badge(@inquiry_status.category) %>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">表示順</dt>
        <dd class="mt-1 text-slate-800"><%= @inquiry_status.sort_order %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">状態</dt>
        <dd class="mt-1 flex gap-1">
          <% if @inquiry_status.is_system? %>
            <%= badge_tag "組み込み（コード変更不可）", color: "slate" %>
          <% end %>
          <%= active_badge(@inquiry_status.is_active?) %>
          <% if @inquiry_status.is_completed? %>
            <%= badge_tag "完了/終了系", color: "slate" %>
          <% end %>
        </dd>
      </div>
    </dl>
  </div>

  <% if !@inquiry_status.is_system? && policy(@inquiry_status).destroy? %>
    <div>
      <%= button_to "このステータスを削除", admin_inquiry_status_path(@inquiry_status), method: :delete,
            form: { data: { turbo_confirm: "#{@inquiry_status.label} を削除しますか？" } },
            class: "btn-danger" %>
    </div>
  <% end %>
</div>
