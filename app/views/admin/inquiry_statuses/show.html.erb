<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @inquiry_status.category %> / <%= @inquiry_status.label %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">コード</dt><dd><%= @inquiry_status.code %></dd>
    <dt class="font-bold">システム定義</dt><dd><%= @inquiry_status.is_system %></dd>
    <dt class="font-bold">有効</dt><dd><%= @inquiry_status.is_active %></dd>
  </dl>
  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_inquiry_statuses_path, class: "underline" %>
    <% if policy(@inquiry_status).update? %><%= link_to "編集", edit_admin_inquiry_status_path(@inquiry_status), class: "underline" %><% end %>
    <% if policy(@inquiry_status).destroy? %>
      <%= button_to "削除", admin_inquiry_status_path(@inquiry_status), method: :delete, form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
