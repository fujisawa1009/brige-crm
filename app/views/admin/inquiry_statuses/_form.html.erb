<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <%= form_with model: inquiry_status, url: url, class: "flex flex-col gap-4 max-w-md" do |f| %>
    <% if inquiry_status.errors.any? %>
      <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"><%= inquiry_status.errors.full_messages.to_sentence %></div>
    <% end %>

    <div>
      <%= f.label :category, "掲示板種別", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.select :category, Inquiry::CATEGORIES, {}, disabled: inquiry_status.persisted?,
            class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm disabled:bg-slate-100 disabled:text-slate-400" %>
    </div>
    <div>
      <%= f.label :code, "コード", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :code, readonly: inquiry_status.is_system?,
            class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm read-only:bg-slate-100 read-only:text-slate-400" %>
      <% if inquiry_status.is_system? %>
        <p class="mt-1 text-xs text-slate-500">システム定義のためコードは変更できません。</p>
      <% end %>
    </div>
    <div>
      <%= f.label :label, "表示名", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :label, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :sort_order, "表示順", class: "mb-1 block text-sm font-medium text-slate-700" %>
      <%= f.number_field :sort_order, class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="flex items-center gap-2">
      <%= f.check_box :is_active, class: "h-4 w-4 rounded border-slate-300" %>
      <%= f.label :is_active, "有効", class: "text-sm font-medium text-slate-700" %>
    </div>
    <div class="flex items-center gap-2">
      <%= f.check_box :is_completed, class: "h-4 w-4 rounded border-slate-300" %>
      <%= f.label :is_completed, "完了/終了系（問い合わせ一覧で既定除外）", class: "text-sm font-medium text-slate-700" %>
    </div>

    <div class="flex gap-2 pt-2">
      <%= f.submit "保存", class: "btn-primary" %>
      <%= link_to "キャンセル", admin_inquiry_statuses_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
