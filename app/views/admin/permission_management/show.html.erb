<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold">権限マトリクス（admin section）</h1>

  <%= button_to "ルート定義からカタログを同期", sync_admin_permission_management_path, method: :post, class: "underline w-fit" %>

  <% editable_roles = @roles.reject(&:admin?) %>

  <%= form_with url: admin_permission_management_path, method: :patch do %>
    <table class="border-collapse w-full text-sm">
      <thead>
        <tr>
          <th class="border px-2 py-1 text-left">権限</th>
          <% @roles.each do |role| %>
            <th class="border px-2 py-1"><%= role.label %><% if role.admin? %>（全許可）<% end %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @permissions.each do |permission| %>
          <tr>
            <td class="border px-2 py-1"><%= permission.display_name %> <span class="text-gray-400">[<%= permission.http_method %>]</span></td>
            <% @roles.each do |role| %>
              <td class="border px-2 py-1 text-center">
                <% if role.admin? %>
                  ✓
                <% else %>
                  <%= check_box_tag "permissions[#{permission.id}][]", role.id,
                        permission.system_roles.include?(role), id: nil %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= submit_tag "保存", class: "bg-blue-600 text-white rounded px-4 py-2 mt-4" %>
  <% end %>
</div>
