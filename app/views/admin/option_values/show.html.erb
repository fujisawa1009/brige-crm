<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @option_value.label %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">グループ</dt><dd><%= @option_value.option_group.label %></dd>
    <dt class="font-bold">親選択肢</dt><dd><%= @option_value.parent&.label %></dd>
    <dt class="font-bold">内部値</dt><dd><%= @option_value.value %></dd>
  </dl>
  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_option_values_path, class: "underline" %>
    <% if policy(@option_value).update? %><%= link_to "編集", edit_admin_option_value_path(@option_value), class: "underline" %><% end %>
    <% if policy(@option_value).destroy? %>
      <%= button_to "削除", admin_option_value_path(@option_value), method: :delete, form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
