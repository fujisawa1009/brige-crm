<% content_for :page_title, "申込ステータス詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900"><%= @customer_status.label %></h2>
      <p class="text-sm text-slate-500 font-mono"><%= @customer_status.code %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_customer_statuses_path,
            class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% if policy(@customer_status).update? %>
        <%= link_to "編集", edit_admin_customer_status_path(@customer_status),
              class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">表示順</dt>
        <dd class="mt-1 text-slate-800"><%= @customer_status.sort_order %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">状態</dt>
        <dd class="mt-1 flex gap-1">
          <% if @customer_status.is_system? %>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">組み込み（コード変更不可）</span>
          <% end %>
          <%= active_badge(@customer_status.is_active?) %>
        </dd>
      </div>
    </dl>
  </div>

  <% if !@customer_status.is_system? && policy(@customer_status).destroy? %>
    <div>
      <%= button_to "このステータスを削除", admin_customer_status_path(@customer_status), method: :delete,
            form: { data: { turbo_confirm: "#{@customer_status.label} を削除しますか？" } },
            class: "rounded-md border border-red-300 bg-red-50 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-100" %>
    </div>
  <% end %>
</div>
