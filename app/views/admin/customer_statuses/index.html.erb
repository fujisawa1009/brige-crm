<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold">顧客ステータス</h1>
  <% if policy(CustomerStatus).create? %><%= link_to "新規作成", new_admin_customer_status_path, class: "underline w-fit" %><% end %>
  <table class="border-collapse w-full text-sm">
    <thead><tr><th class="border px-2 py-1 text-left">コード</th><th class="border px-2 py-1 text-left">表示名</th><th class="border px-2 py-1 text-left">システム定義</th></tr></thead>
    <tbody>
      <% @customer_statuses.each do |status| %>
        <tr>
          <td class="border px-2 py-1"><%= status.code %></td>
          <td class="border px-2 py-1"><%= link_to status.label, admin_customer_status_path(status) %></td>
          <td class="border px-2 py-1"><%= status.is_system %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
