<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold">初期費用</h1>
  <% if policy(ProductInitialFee).create? %><%= link_to "新規作成", new_admin_product_initial_fee_path, class: "underline w-fit" %><% end %>
  <table class="border-collapse w-full text-sm">
    <thead><tr><th class="border px-2 py-1 text-left">商材</th><th class="border px-2 py-1 text-left">名称</th><th class="border px-2 py-1 text-left">金額</th></tr></thead>
    <tbody>
      <% @product_initial_fees.each do |fee| %>
        <tr>
          <td class="border px-2 py-1"><%= fee.product.name %></td>
          <td class="border px-2 py-1"><%= link_to fee.name, admin_product_initial_fee_path(fee) %></td>
          <td class="border px-2 py-1"><%= fee.amount %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
