<% content_for :page_title, "初期費用" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900">初期費用</h2>
      <p class="text-sm text-slate-500">商材ごとの初期費用テンプレートを管理します。</p>
    </div>
    <% if policy(ProductInitialFee).create? %>
      <%= link_to "新規作成", new_admin_product_initial_fee_path,
            class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <th class="px-4 py-3">商材</th>
          <th class="px-4 py-3">名称</th>
          <th class="px-4 py-3">金額</th>
          <th class="px-4 py-3">状態</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @product_initial_fees.empty? %>
          <tr>
            <td colspan="5" class="px-4 py-8 text-center text-slate-500">初期費用が登録されていません</td>
          </tr>
        <% end %>
        <% @product_initial_fees.each do |fee| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 text-slate-600"><%= link_to fee.product.name, admin_product_path(fee.product), class: "hover:underline" %></td>
            <td class="px-4 py-3 font-medium text-slate-800"><%= link_to fee.name, admin_product_initial_fee_path(fee), class: "hover:underline" %></td>
            <td class="px-4 py-3 text-slate-600"><%= number_to_currency(fee.amount, unit: "¥", precision: 0) if fee.amount %></td>
            <td class="px-4 py-3"><%= active_badge(fee.is_active?) %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "詳細", admin_product_initial_fee_path(fee), class: "text-indigo-600 hover:underline" %>
              <% if policy(fee).update? %>
                <%= link_to "編集", edit_admin_product_initial_fee_path(fee), class: "ml-3 text-indigo-600 hover:underline" %>
              <% end %>
              <% if policy(fee).destroy? %>
                <%= button_to "削除", admin_product_initial_fee_path(fee), method: :delete,
                      form: { data: { turbo_confirm: "#{fee.name} を削除しますか？" }, class: "inline ml-3" },
                      class: "text-red-600 hover:underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
