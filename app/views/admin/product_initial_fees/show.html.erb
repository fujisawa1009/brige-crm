<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold"><%= @product_initial_fee.name %></h1>
  <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="font-bold">商材</dt><dd><%= @product_initial_fee.product.name %></dd>
    <dt class="font-bold">金額</dt><dd><%= @product_initial_fee.amount %></dd>
    <dt class="font-bold">有効</dt><dd><%= @product_initial_fee.is_active %></dd>
  </dl>
  <div class="flex gap-3">
    <%= link_to "一覧に戻る", admin_product_initial_fees_path, class: "underline" %>
    <% if policy(@product_initial_fee).update? %><%= link_to "編集", edit_admin_product_initial_fee_path(@product_initial_fee), class: "underline" %><% end %>
    <% if policy(@product_initial_fee).destroy? %>
      <%= button_to "削除", admin_product_initial_fee_path(@product_initial_fee), method: :delete, form: { data: { turbo_confirm: "削除しますか？" } } %>
    <% end %>
  </div>
</div>
