<% content_for :page_title, "初期費用詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900"><%= @product_initial_fee.name %></h2>
      <p class="text-sm text-slate-500"><%= @product_initial_fee.product.name %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_product_initial_fees_path,
            class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% if policy(@product_initial_fee).update? %>
        <%= link_to "編集", edit_admin_product_initial_fee_path(@product_initial_fee),
              class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">商材</dt>
        <dd class="mt-1"><%= link_to @product_initial_fee.product.name, admin_product_path(@product_initial_fee.product), class: "text-indigo-600 hover:underline" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">金額</dt>
        <dd class="mt-1 text-slate-800"><%= number_to_currency(@product_initial_fee.amount, unit: "¥", precision: 0) if @product_initial_fee.amount %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">状態</dt>
        <dd class="mt-1"><%= active_badge(@product_initial_fee.is_active?) %></dd>
      </div>
    </dl>
  </div>

  <% if policy(@product_initial_fee).destroy? %>
    <div>
      <%= button_to "この初期費用を削除", admin_product_initial_fee_path(@product_initial_fee), method: :delete,
            form: { data: { turbo_confirm: "#{@product_initial_fee.name} を削除しますか？" } },
            class: "rounded-md border border-red-300 bg-red-50 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-100" %>
    </div>
  <% end %>
</div>
