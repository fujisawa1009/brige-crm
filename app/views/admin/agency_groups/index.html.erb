<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold">代理店グループ</h1>
  <%= link_to "新規作成", new_admin_agency_group_path, class: "underline w-fit" %>

  <table class="border-collapse w-full text-sm">
    <thead>
      <tr>
        <th class="border px-2 py-1 text-left">グループCD</th>
        <th class="border px-2 py-1 text-left">名称</th>
        <th class="border px-2 py-1 text-left">サービス種別</th>
        <th class="border px-2 py-1"></th>
      </tr>
    </thead>
    <tbody>
      <% @agency_groups.each do |agency_group| %>
        <tr>
          <td class="border px-2 py-1"><%= agency_group.group_code %></td>
          <td class="border px-2 py-1"><%= link_to agency_group.name, admin_agency_group_path(agency_group) %></td>
          <td class="border px-2 py-1"><%= agency_group.service_type %></td>
          <td class="border px-2 py-1"></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
