<% content_for :page_title, "代理店グループ詳細" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900"><%= @agency_group.name %></h2>
      <p class="text-sm text-slate-500 font-mono"><%= @agency_group.group_code %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "一覧に戻る", admin_agency_groups_path,
            class: "btn-secondary" %>
      <% if policy(@agency_group).update? %>
        <%= link_to "編集", edit_admin_agency_group_path(@agency_group),
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">基本情報</h3>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">サービス種別</dt>
        <dd class="mt-1"><%= badge_tag @agency_group.service_type, color: (@agency_group.service_type == "BridgePlus" ? "purple" : "blue") %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">連絡先メール</dt>
        <dd class="mt-1 text-slate-800"><%= @agency_group.contact_email.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">Bridgeプラン表示区分</dt>
        <dd class="mt-1 text-slate-800"><%= @agency_group.bridge_plan_display_type.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">CSVダウンロード表示</dt>
        <dd class="mt-1 text-slate-800"><%= @agency_group.csv_download_visible? ? "表示" : "非表示" %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs text-slate-500">許可商材</dt>
        <dd class="mt-1">
          <% if @agency_group.products.any? %>
            <div class="flex flex-wrap gap-1">
              <% @agency_group.products.each do |product| %>
                <span class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600"><%= product.name %></span>
              <% end %>
            </div>
          <% else %>
            <span class="text-slate-400">—</span>
          <% end %>
        </dd>
      </div>
    </dl>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">配下代理店（<%= @agency_group.agencies.size %>件）</h3>
    <% if @agency_group.agencies.any? %>
      <ul class="divide-y divide-slate-100">
        <% @agency_group.agencies.order(:name).each do |agency| %>
          <li class="flex items-center justify-between py-2 text-sm">
            <%= link_to agency.name, admin_agency_path(agency), class: "font-medium text-slate-800 hover:underline" %>
            <span class="font-mono text-xs text-slate-500"><%= agency.agency_code %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-500">配下の代理店はまだ登録されていません。</p>
    <% end %>
  </div>

  <% if policy(@agency_group).destroy? %>
    <div>
      <%= button_to "この代理店グループを削除", admin_agency_group_path(@agency_group), method: :delete,
            form: { data: { turbo_confirm: "#{@agency_group.name} を削除しますか？（配下に代理店が存在する場合は削除できません）" } },
            class: "btn-danger" %>
    </div>
  <% end %>
</div>
