<% content_for :page_title, "顧客" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900">顧客</h2>
      <p class="text-sm text-slate-500">申込・契約中の顧客を管理します。</p>
    </div>
    <div class="flex gap-2">
      <% if policy(Customer).index? %>
        <%= button_to "CSVエクスポート", export_admin_customers_path, method: :post,
              class: "btn-secondary" %>
      <% end %>
      <% if policy(Customer).create? %>
        <%= link_to "新規作成", new_admin_customer_path,
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_customers_path, method: :get, class: "grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3" do %>
      <div>
        <label class="mb-1 block text-xs font-medium text-slate-500">顧客番号・氏名</label>
        <%= text_field_tag :q, params[:q], placeholder: "顧客番号・氏名で検索",
              class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-slate-500">申込ステータス</label>
        <%= select_tag :status, options_from_collection_for_select(CustomerStatus.ordered, :code, :label, params[:status]),
              include_blank: "すべて", class: "w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div class="col-span-full flex items-center justify-between pt-1">
        <span class="text-sm text-slate-500">全 <%= number_with_delimiter(@pagy.count) %> 件</span>
        <div class="flex gap-2">
          <%= link_to "クリア", admin_customers_path, class: "btn-secondary" %>
          <%= submit_tag "検索", class: "rounded-md bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <th class="px-4 py-3">顧客番号</th>
          <th class="px-4 py-3">氏名・法人名</th>
          <th class="px-4 py-3">所属代理店</th>
          <th class="px-4 py-3">担当営業</th>
          <th class="px-4 py-3">申込ステータス</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @customers.empty? %>
          <tr>
            <td colspan="6" class="px-4 py-8 text-center text-slate-500">該当する顧客が見つかりません</td>
          </tr>
        <% end %>
        <% @customers.each do |customer| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-mono text-slate-600"><%= link_to customer.customer_number, admin_customer_path(customer), class: "hover:underline" %></td>
            <td class="px-4 py-3 font-medium text-slate-800"><%= customer.name %></td>
            <td class="px-4 py-3 text-slate-600"><%= customer.agency.name %></td>
            <td class="px-4 py-3 text-slate-600"><%= customer.sales_representative&.name || "—" %></td>
            <td class="px-4 py-3">
              <%= customer_status_badge(customer.status) %>
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "詳細", admin_customer_path(customer), class: "text-indigo-600 hover:underline" %>
              <% if policy(customer).update? %>
                <%= link_to "編集", edit_admin_customer_path(customer), class: "ml-3 text-indigo-600 hover:underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
