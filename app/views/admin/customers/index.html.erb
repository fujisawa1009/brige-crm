<% content_for :page_title, "顧客" %>

<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-slate-900">顧客</h2>
      <p class="text-sm text-slate-500">申込・契約中の顧客を管理します。</p>
    </div>
    <div class="flex gap-2">
      <% if policy(Customer).index? %>
        <%= button_to "CSVエクスポート", export_admin_customers_path, method: :post,
              class: "btn-secondary" %>
      <% end %>
      <% if policy(Customer).create? %>
        <%= link_to "新規作成", new_admin_customer_path,
              class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <%#
    顧客検索（CEO指示 2026-08-20 の9条件）。条件の実体は app/services/customer_search.rb。
    当初は7条件を details「詳細条件」に畳んでいたが、CEO指示（2026-08-20 画面目視）により
    折りたたみを廃止し、9条件すべてを最初から見えている状態にした。
    縦の間延びを防ぐため、テキスト系条件は3列グリッド、日付レンジは1行2列に分けて並べる。
  %>
  <% input_class = "w-full min-w-0 rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: admin_customers_path, method: :get, class: "flex flex-col gap-3" do %>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <div class="sm:col-span-2">
          <label class="mb-1 block text-xs font-medium text-slate-500">フリーワード</label>
          <%= text_field_tag :q, customer_search_params[:q], placeholder: "顧客番号・氏名・カナ・代表者名・メール・電話",
                class: input_class %>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium text-slate-500">ステータス</label>
          <%= select_tag :status, options_from_collection_for_select(CustomerStatus.ordered, :code, :label, customer_search_params[:status]),
                include_blank: "すべて", class: input_class %>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium text-slate-500">FTWEB顧客番号</label>
          <%= text_field_tag :customer_number, customer_search_params[:customer_number], placeholder: "C-000001",
                class: input_class %>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium text-slate-500">グループ会社コード</label>
          <%= text_field_tag :group_code, customer_search_params[:group_code], placeholder: "完全一致",
                class: input_class %>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium text-slate-500">グループ会社名</label>
          <%= text_field_tag :group_name, customer_search_params[:group_name], placeholder: "部分一致",
                class: input_class %>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium text-slate-500">代理店コード</label>
          <%= text_field_tag :agency_code, customer_search_params[:agency_code], placeholder: "完全一致",
                class: input_class %>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium text-slate-500">代理店名</label>
          <%= text_field_tag :agency_name, customer_search_params[:agency_name], placeholder: "部分一致",
                class: input_class %>
        </div>
        <%#
          退会済みの表示切替（CEO指示 2026-08-20。旧ジャスミンの show_withdrawn 相当）。
          一覧は既定で退会済みを除外し、チェックしたときだけ含める。他の入力欄と下端を
          揃えたいので items-end で下寄せする（他はラベル1行ぶん上に積まれているため）。
        %>
        <div class="flex items-end">
          <label class="flex w-full cursor-pointer items-center gap-2 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700">
            <%= check_box_tag :show_withdrawn, "1", CustomerSearch.show_withdrawn?(customer_search_params),
                  class: "h-4 w-4 rounded border-slate-300 text-slate-800" %>
            退会済みを含む
          </label>
        </div>
      </div>

      <%# 日付レンジは1つのセルに入力欄が2つ入るため、テキスト系より広い1行2列で並べる。 %>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div>
          <label class="mb-1 block text-xs font-medium text-slate-500">お申込日</label>
          <div class="flex items-center gap-2">
            <%= date_field_tag :applied_from, customer_search_params[:applied_from], class: input_class %>
            <span class="text-sm text-slate-400">〜</span>
            <%= date_field_tag :applied_to, customer_search_params[:applied_to], class: input_class %>
          </div>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium text-slate-500">最終更新日時</label>
          <div class="flex items-center gap-2">
            <%= date_field_tag :updated_from, customer_search_params[:updated_from], class: input_class %>
            <span class="text-sm text-slate-400">〜</span>
            <%= date_field_tag :updated_to, customer_search_params[:updated_to], class: input_class %>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
        <span class="text-sm text-slate-500">全 <%= number_with_delimiter(@pagy.count) %> 件</span>
        <div class="flex gap-2">
          <%= link_to "クリア", admin_customers_path, class: "btn-secondary" %>
          <%= submit_tag "検索", class: "rounded-md bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <th class="px-4 py-3">顧客番号</th>
          <th class="px-4 py-3">氏名・法人名</th>
          <th class="px-4 py-3">所属代理店</th>
          <th class="px-4 py-3">担当営業</th>
          <th class="px-4 py-3">ステータス</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if @customers.empty? %>
          <tr>
            <td colspan="6" class="px-4 py-8 text-center text-slate-500">該当する顧客が見つかりません</td>
          </tr>
        <% end %>
        <% @customers.each do |customer| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-mono text-slate-600"><%= link_to customer.customer_number, admin_customer_path(customer), class: "hover:underline" %></td>
            <td class="px-4 py-3 font-medium text-slate-800"><%= customer.name %></td>
            <td class="px-4 py-3 text-slate-600"><%= customer.agency.name %></td>
            <td class="px-4 py-3 text-slate-600"><%= customer.sales_representative&.name || "—" %></td>
            <td class="px-4 py-3">
              <%= customer_status_badge(customer.status) %>
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "詳細", admin_customer_path(customer), class: "text-indigo-600 hover:underline" %>
              <% if policy(customer).update? %>
                <%= link_to "編集", edit_admin_customer_path(customer), class: "ml-3 text-indigo-600 hover:underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
</div>
