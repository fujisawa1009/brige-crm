<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Brige Crm 管理画面" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Brige Crm">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-900">
    <div class="flex min-h-screen" data-controller="sidebar">
      <div data-sidebar-target="backdrop" data-action="click->sidebar#close"
           class="fixed inset-0 z-30 hidden bg-slate-900/50 md:hidden"></div>

      <aside data-sidebar-target="panel"
             class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col bg-slate-900 text-slate-200 transition-transform duration-200 ease-in-out md:static md:translate-x-0">
        <div class="flex h-16 shrink-0 items-center gap-2 border-b border-slate-800 px-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-500 text-sm font-bold text-white">BC</span>
          <span class="text-base font-semibold tracking-wide text-white">Brige CRM</span>
        </div>

        <nav class="flex-1 overflow-y-auto px-3 py-4">
          <% visible_admin_nav_sections.each do |section| %>
            <div class="mb-5">
              <% if section.title %>
                <p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wider text-slate-500"><%= section.title %></p>
              <% end %>
              <ul class="space-y-0.5">
                <% section.items.each do |item| %>
                  <li>
                    <%= link_to item.label, item.path,
                        class: [
                          "block rounded-md px-3 py-2 text-sm font-medium transition-colors",
                          current_page?(item.path) ? "bg-indigo-500/15 text-white" : "text-slate-300 hover:bg-slate-800 hover:text-white"
                        ].join(" ") %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </nav>
      </aside>

      <div class="flex min-h-screen flex-1 flex-col md:pl-0">
        <header class="sticky top-0 z-20 flex h-16 shrink-0 items-center gap-4 border-b border-slate-200 bg-white px-4 md:px-8">
          <button type="button" data-action="click->sidebar#toggle"
                  class="rounded-md p-2 text-slate-500 hover:bg-slate-100 md:hidden" aria-label="メニューを開く">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>

          <h1 class="text-lg font-semibold text-slate-800"><%= content_for(:page_title) %></h1>

          <div class="ml-auto flex items-center gap-4">
            <div class="hidden text-right sm:block">
              <p class="text-sm font-medium text-slate-800"><%= current_user.name %></p>
              <p class="text-xs text-slate-500"><%= current_user.email %></p>
            </div>
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold text-indigo-700">
              <%= current_user.name.first %>
            </span>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete,
                class: "rounded-md border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100" %>
          </div>
        </header>

        <main class="flex-1 px-4 py-6 md:px-8">
          <% if notice %><p class="notice mb-4 rounded bg-green-100 px-4 py-2 text-green-800"><%= notice %></p><% end %>
          <% if alert %><p class="alert mb-4 rounded bg-red-100 px-4 py-2 text-red-800"><%= alert %></p><% end %>
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
